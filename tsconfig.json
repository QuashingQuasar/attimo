{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "jsxImportSource": "react",
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["src/*"],
      "@astro/*": ["src/astro/*"]
    }
  },
  "include": ["src/**/*", ".astro/types.d.ts"]
}
