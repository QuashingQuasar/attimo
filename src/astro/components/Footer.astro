---
// English footer for Astro-rendered pages (blog). Mirrors the React Footer
// (src/components/Footer.tsx) column structure so the footer is consistent
// site-wide and the /high-polyphenol-olive-oil hub is linked everywhere.
const shop = [
  { label: "Coratina", href: "/product/coratina" },
  { label: "Picual", href: "/product/picual" },
  { label: "Nocellara", href: "/product/nocellara" },
  { label: "High-Polyphenol Olive Oil", href: "/high-polyphenol-olive-oil" },
  { label: "Merch", href: "/merch" },
];
const learn = [
  { label: "Blog", href: "/blog" },
  { label: "Quiz", href: "/quiz" },
  { label: "Ambassadors", href: "/ambassadors" },
];
const company = [
  { label: "Shipping", href: "/shipping" },
  { label: "Contact", href: "/contact" },
  { label: "Manage Orders & Subscription", href: "https://shop.attimo-oil.com/account" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
];
const columns = [
  { heading: "Shop", links: shop },
  { heading: "Learn", links: learn },
  { heading: "Company", links: company },
];
const headingStyle = "font-family: 'UDC Working Man Sans', sans-serif; color: #FFFAEA; letter-spacing: 0.12em; font-size: 0.8rem; text-transform: uppercase;";
const linkStyle = "font-family: 'Space Grotesk', sans-serif; color: #B3E58C; font-size: 0.875rem;";
---

<footer class="py-14 md:py-20 lg:py-24 px-6" style="background-color: #1B4229;">
  <div class="container mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-8 mb-12">
      <div class="col-span-2 md:col-span-1 flex flex-col gap-5">
        <img src="/assets/footer-logo.svg" alt="ATTIMO" class="h-14 w-auto self-start" />
        <a href="https://www.instagram.com/attimo.oil" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity inline-flex" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3E58C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
        </a>
      </div>

      {columns.map((col) => (
        <div>
          <h4 class="mb-4" style={headingStyle}>{col.heading}</h4>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="hover:underline transition-colors" style={linkStyle}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t pt-6" style="border-color: #B3E58C;">
      <p class="text-sm" style="font-family: 'Space Grotesk', sans-serif; color: #B3E58C;">© 2026 ATTIMO. All rights reserved.</p>
    </div>
  </div>
</footer>
