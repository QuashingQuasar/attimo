---
// Locale-aware footer for Astro-rendered pages (blog). Mirrors the React Footer
// (src/components/Footer.tsx) column structure, labels, and localized hrefs so
// the footer matches the page's language everywhere.
import { DEFAULT_LOCALE, localizeHref, type Locale } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };
const t = getDict(locale);

// Polyphenol + early-harvest hubs live at translated slugs per language.
const hubLinks =
  locale.lang === "de"
    ? [
        { label: "Polyphenolreiches Olivenöl", href: "/de/polyphenolreiches-olivenoel" },
        { label: "Frühe Ernte Olivenöl", href: "/de/fruehe-ernte-olivenoel" },
      ]
    : locale.lang === "fr"
    ? [
        { label: "Huile d'Olive Riche en Polyphénols", href: "/fr/huile-olive-riche-polyphenols" },
        { label: "Huile d'Olive Récolte Précoce", href: "/fr/huile-olive-recolte-precoce" },
      ]
    : locale.lang === "sv"
    ? [
        { label: "Polyfenolrik Olivolja", href: "/se/polyfenolrik-olivolja" },
        { label: "Tidig Skörd Olivolja", href: "/se/tidig-skord-olivolja" },
      ]
    : locale.lang === "da"
    ? [
        { label: "Polyfenolrig Olivenolie", href: "/dk/polyfenolrig-olivenolie" },
        { label: "Tidlig Høst Olivenolie", href: "/dk/tidlig-hoest-olivenolie" },
      ]
    : [
        { label: "High-Polyphenol Olive Oil", href: "/high-polyphenol-olive-oil" },
        { label: "Early Harvest Olive Oil", href: "/early-harvest-olive-oil" },
      ];

const shop = [
  { label: "Coratina", href: localizeHref("/product/coratina", locale) },
  { label: "Picual", href: localizeHref("/product/picual", locale) },
  { label: "Nocellara", href: localizeHref("/product/nocellara", locale) },
  ...hubLinks,
  { label: t.nav.merch, href: "/merch" },
];
const learn = [
  { label: t.footer.blog, href: localizeHref("/blog", locale) },
  { label: t.nav.quiz, href: localizeHref("/quiz", locale) },
  { label: t.footer.ambassadors, href: localizeHref("/ambassadors", locale) },
];
const company = [
  { label: t.footer.shipping, href: localizeHref("/shipping", locale) },
  { label: t.footer.contact, href: "/contact" },
  { label: t.footer.manageOrders, href: "https://shop.attimo-oil.com/account" },
  { label: t.footer.privacy, href: "/privacy" },
  { label: t.footer.terms, href: "/terms" },
];
const columns = [
  { heading: t.footer.shop, links: shop },
  { heading: t.footer.learn, links: learn },
  { heading: t.footer.company, links: company },
];
const headingStyle = "font-family: 'UDC Working Man Sans', sans-serif; color: #FFFAEA; letter-spacing: 0.12em; font-size: 0.8rem; text-transform: uppercase;";
const linkStyle = "font-family: 'Space Grotesk', sans-serif; color: #B3E58C; font-size: 0.875rem;";
---

<footer class="py-14 md:py-20 lg:py-24 px-6" style="background-color: #1B4229;">
  <div class="container mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-8 mb-12">
      <div class="col-span-2 md:col-span-1 flex flex-col gap-5">
        <img src="/assets/footer-logo.svg" alt="ATTIMO" class="h-14 w-auto self-start" />
        <a href="https://www.instagram.com/attimo.oil" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity inline-flex" aria-label="Instagram">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3E58C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
        </a>
      </div>

      {columns.map((col) => (
        <div>
          <h4 class="mb-4" style={headingStyle}>{col.heading}</h4>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((l) => (
              <li><a href={l.href} class="hover:underline transition-colors" style={linkStyle}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t pt-6" style="border-color: #B3E58C;">
      <p class="text-sm" style="font-family: 'Space Grotesk', sans-serif; color: #B3E58C;">{t.footer.rights}</p>
    </div>
  </div>
</footer>
