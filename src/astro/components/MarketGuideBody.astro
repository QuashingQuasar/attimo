---
// Body of a market buying guide (one country or region, one language). Rows
// come from the Polyphenol Index filtered to oils a buyer in this market can
// get, in Index order (oleocanthal + oleacein). No composite score: Gilles
// dropped it on 10 Nov 2026. Strings come from `content`.
import { Header } from "@/components/Header";
import { FAQ } from "@/components/FAQ";
import { OilProductWidgets } from "@/components/OilProductWidgets";
import { Toaster as Sonner } from "@/components/ui/sonner";
import Footer from "@astro/components/Footer.astro";
import { formatPrice, type Locale } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";
import { GREEN, DEEP, CREAM, ACCENT, LIME, UDC, SG, h2, eyebrow, eyebrowSm, lead, small, stat, btn, cardOnCream } from "@/lib/certificates/ui";
import { guideShipping } from "@/lib/marketGuides/fill";
import type { HomeLabOil } from "@/lib/certificates/homeNumbers";
import { INDEX_SLUGS, INDEX_CONTENT } from "@/lib/polyphenolIndexContent";
import { METHODS_SLUGS } from "@/lib/polyphenolMethodsContent";
import { certHrefFor } from "@/lib/certificatesContent";
import { verifiedFor, type IndexEntry } from "@/lib/polyphenolIndex";
import type { MarketGuideContent, ShipEvidence, CriterionKey } from "@/lib/marketGuides";
import OilCard from "@astro/components/OilCard.astro";

const { content: c, entries, shipping, locale, heroImage, labNumbers = [] } = Astro.props as {
  content: MarketGuideContent; entries: IndexEntry[]; shipping: Record<string, ShipEvidence>; locale: Locale; heroImage: string; labNumbers?: HomeLabOil[];
};
const t = getDict(locale);
const { tier, standard, freeFrom, days, freeFromWord, fill } = guideShipping(c, locale);
const onCream = (a = 0.6) => `rgba(27,66,41,${a})`;
const onGreen = (a = 0.6) => `rgba(255,250,234,${a})`;
const indexHref = INDEX_SLUGS[c.lang as keyof typeof INDEX_SLUGS] ?? INDEX_SLUGS.en;
const methodsHref = METHODS_SLUGS[c.lang as keyof typeof METHODS_SLUGS] ?? METHODS_SLUGS.en;
const notes = INDEX_CONTENT[c.lang]?.entryNotes ?? {};
const idx = (INDEX_CONTENT[c.lang] ?? INDEX_CONTENT.en).index;
// Label of the per-card disclosure (plus/minus, notes, sources).
const DETAILS: Record<string, string> = { en: "Details and sources", nl: "Details en bronnen", fr: "Détails et sources", de: "Details und Quellen", da: "Detaljer og kilder", sv: "Detaljer och källor" };
const isMine = (e: IndexEntry) => e.attimo_certificate !== null;
// Thousands separator: a comma in English, a point elsewhere.
const SEP = c.lang === "en" ? "," : ".";
const num = (n: number | null) => (n === null ? "" : n >= 1000 ? `${String(n).slice(0, -3)}${SEP}${String(n).slice(-3)}` : String(n));

// ATTIMO's own evidence: the shipping tier for this market.
// A regional guide (Europe) counts an EU-wide statement in full; a seller that
// only reaches some countries scores lower there.
const regional = !!c.regional;
const mineEvidence: ShipEvidence = { ships: "yes", basis: regional ? "EU-wide statement" : "lists country", route: "webshop", days, cost: standard, free_from: freeFrom, quote: "", source_url: "", checked: c.updated };
const evidenceFor = (e: IndexEntry): ShipEvidence | undefined => (isMine(e) ? mineEvidence : shipping[e.id]);

// Only oils a buyer here can get.
const buyable = entries.filter((e) => {
  const ev = evidenceFor(e);
  return !!ev && (ev.ships === "yes" || (ev.route && ["retailer", "distributor", "request"].includes(ev.route)));
});

// Methods that count each compound on its own; the NMR caveat applies to the rest.
const CHROMATOGRAPHY = new Set(["HPLC", "COI", "LC-MS/MS"]);
const METHOD_LABEL: Record<string, string> = { COI: "HPLC (COI)" };
const methodOf = (e: IndexEntry) => METHOD_LABEL[e.method] ?? e.method;
const isPaid = (ev: ShipEvidence) => !!ev.cost && ev.cost !== "not stated" && !/^(gratis|free)$/i.test(ev.cost);

const glanceRows = [...buyable].sort((a, b) => {
  if (a.compounds !== null && b.compounds === null) return -1;
  if (a.compounds === null && b.compounds !== null) return 1;
  return (b.compounds ?? 0) - (a.compounds ?? 0) || (b.total ?? 0) - (a.total ?? 0);
});
const lab = (key: string) => labNumbers.find((o) => o.key === key);
const fmtLab = (o: HomeLabOil | undefined) => (o && o.total !== null ? `${o.name} (${num(o.total)} mg/kg, ${o.methodLine.split(",")[0]})` : "");
const attimoAlso = c.glance.labels.attimoAlso.replace("{nocellara}", fmtLab(lab("nocellara"))).replace("{picual}", fmtLab(lab("picual")));
const eur = (v: number) => `€${v.toFixed(2).replace(".", c.lang === "en" ? "." : ",")}`;
const valueOf = (e: IndexEntry) => (e.value_per_100mg === null ? "" : eur(e.value_per_100mg));
const priceOf = (e: IndexEntry) => (isMine(e) ? `${formatPrice(locale.prices.coratina, locale)} / 500 ml` : e.price && !/^not listed/i.test(e.price) ? e.price : "");
const verifiedOf = (_e: IndexEntry) => verifiedFor(c.lang);
const costLine = (ev: ShipEvidence) => {
  const freeFrom = ev.free_from ? `${freeFromWord} ${ev.free_from}` : "";
  if (!ev.cost || ev.cost === "not stated") return freeFrom || c.glance.labels.notStated;
  return freeFrom ? `${ev.cost}, ${freeFrom}` : ev.cost;
};

const buyLabel = (ev: ShipEvidence | undefined) => {
  if (!ev) return "";
  if (ev.route === "retailer") return `${c.table.buy.retailer}${ev.seller ? `: ${ev.seller}` : ""}`;
  if (ev.route === "distributor") return `${c.table.buy.distributor}${ev.seller ? `: ${ev.seller}` : ""}`;
  if (ev.route === "request") return c.table.buy.request;
  if (ev.basis === "lists country") return c.table.buy.webshop;
  if (ev.basis === "EU-wide statement") return c.table.buy.webshopEu;
  return c.table.buy.webshopWorld;
};
const prosOf = (e: IndexEntry) => {
  const ev = evidenceFor(e)!; const out: string[] = [];
  if (e.report?.status === "viewable") out.push(c.oils.pros.report);
  if (e.compounds !== null) out.push(c.oils.pros.hplc); else if (e.method !== "not stated") out.push(c.oils.pros.method);
  if (e.variety && e.harvest) out.push(c.oils.pros.origin);
  if (ev.basis === "lists country") out.push(c.oils.pros.shipsNl.replace("{days}", ev.days === "not stated" ? "" : ev.days).replace(/,\s*$/, ""));
  else if (ev.basis === "EU-wide statement") out.push(c.oils.pros.shipsEu);
  return out;
};
const consOf = (e: IndexEntry) => {
  const ev = evidenceFor(e)!; const out: string[] = [];
  if (e.report?.status !== "viewable") out.push(c.oils.cons.noReport);
  if (e.method === "not stated") out.push(c.oils.cons.noMethod); else if (e.compounds === null) out.push(c.oils.cons.totalOnly); else if (!CHROMATOGRAPHY.has(e.method)) out.push(c.oils.cons.nmr);
  if (!(e.variety && e.harvest)) out.push(c.oils.cons.noOrigin);
  if (ev.days === "not stated") out.push(c.oils.cons.noDays);
  if (ev.basis === "worldwide statement" || (!regional && ev.basis === "EU-wide statement")) out.push(c.oils.cons.nlNotNamed);
  if (isPaid(ev)) out.push((ev.free_from ? c.oils.cons.shippingFree : c.oils.cons.shipping).replace("{cost}", ev.cost!).replace("{free}", ev.free_from ?? ""));
  out.push(...(c.oils.perOil[e.id]?.cons ?? []).map(fill));
  return out;
};
const sourceOf = (e: IndexEntry) => {
  const ev = evidenceFor(e);
  if (isMine(e) && e.attimo_certificate) return { href: certHrefFor(c.lang, e.attimo_certificate), label: "ATTIMO", quote: "" };
  const href = ev?.source_url || e.source_url;
  return { href, label: new URL(href).hostname.replace(/^www\./, ""), quote: ev?.quote ?? "" };
};
const checked = [...new Set(Object.values(shipping).map((s) => s.checked))].sort().pop() ?? c.updated;

// ── Tooltips, prices in euros, score breakdown ──
import InfoTip from "@astro/components/InfoTip.astro";
import { tipsFor } from "@/lib/oilTips";
import { FX } from "@/lib/polyphenolIndex";
const tips = tipsFor(c.lang);
const tipLabel = tips?.label ?? "{x}";
const tl = (x: string) => tipLabel.replace("{x}", x.toLowerCase());
const PER500: Record<string, string> = { en: "per 500 ml", nl: "per 500 ml", fr: "les 500 ml", de: "pro 500 ml", da: "pr. 500 ml", sv: "per 500 ml" };
const FOR: Record<string, string> = { en: "for", nl: "voor", fr: "pour", de: "für", da: "for", sv: "för" };
const SYM: Record<string, string> = { EUR: "€", USD: "$", GBP: "£" };
const dec = (v: number) => (c.lang === "en" ? v.toFixed(2) : v.toFixed(2).replace(".", ","));
const money = (v: number, sym = "€") => (Number.isInteger(v) ? `${sym}${v}` : `${sym}${dec(v)}`);
/** Price per 500 ml in euros; the original price as the reference when it differs. */
const priceInfo = (e: IndexEntry) => {
  if (isMine(e)) { const v = locale.prices.coratina; return { eur: v, short: money(v), main: `${money(v)} ${PER500[c.lang] ?? PER500.en}`, original: "" }; }
  if (e.price_eur_500ml === null || !e.price_amount || !e.price_currency || !e.price_ml) {
    const txt = priceOf(e); return { eur: null, short: "", main: txt || c.glance.labels.notStated, original: "" };
  }
  const converted = e.price_currency !== "EUR";
  const v = converted ? Math.round(e.price_eur_500ml) : e.price_eur_500ml;
  const short = `${converted ? "≈ " : ""}${money(v)}`;
  const differs = converted || e.price_ml !== 500;
  return { eur: e.price_eur_500ml, short, main: `${short} ${PER500[c.lang] ?? PER500.en}`, original: differs ? `${money(e.price_amount, SYM[e.price_currency])} ${FOR[c.lang] ?? "for"} ${e.price_ml} ml` : "" };
};
/** A shipping cost in dollars or pounds, shown in euros with the original next to it. */
const toEur = (s: string) => {
  const m = s.match(/^([$£])\s?([\d.,]+)/);
  if (!m) return s;
  const v = parseFloat(m[2].replace(",", "")) * (m[1] === "$" ? FX.USD : FX.GBP);
  return `≈ ${money(Math.round(v))} (${s})`;
};
const shipLine = (ev: ShipEvidence) => toEur(costLine(ev));
/** Shipping in euros for sorting: 0 when free, null when unknown. */
const shipEur = (ev: ShipEvidence): number | null => {
  if (ev.cost && /^(gratis|free|gratuit|kostenlos)$/i.test(ev.cost)) return 0;
  const m = (ev.cost ?? "").match(/([$£€])\s?([\d.,]+)|([\d.,]+)\s?(€|kr)/);
  if (!m) return null;
  const sym = m[1] ?? m[4]; const raw = (m[2] ?? m[3]).replace(",", ".");
  const v = parseFloat(raw);
  return sym === "$" ? v * FX.USD : sym === "£" ? v * FX.GBP : sym === "kr" ? null : v;
};
const chevron = '<svg class="oil-acc-chev" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5 L7 9 L11 5" /></svg>';
const detailLabel = `font-family:${UDC}; font-weight:700; font-size:.78rem; letter-spacing:.08em; text-transform:uppercase; color:${GREEN};`;
const checkedHuman = new Intl.DateTimeFormat(locale.lang === "en" ? "en-GB" : locale.hreflang, { day: "numeric", month: "long", year: "numeric" }).format(new Date(checked + "T12:00:00Z"));
// Table columns. Widths keep all eight on one screen from 1024 px.
const COLS = [
  { key: "oil", label: c.table.cols.oil, num: false, w: "var(--oil-w)", tip: null, icon: false },
  { key: "total", label: c.table.cols.total, num: true, w: "11%", tip: tips?.total, icon: true },
  { key: "compounds", label: c.table.cols.compounds, num: true, w: "12%", tip: tips?.compounds, icon: true },
  { key: "method", label: c.table.cols.method, num: false, w: "10%", tip: null, icon: false },
  { key: "price", label: c.table.cols.price, num: true, w: "10%", tip: null, icon: false },
  { key: "value", label: c.table.cols.value, num: true, w: "12%", tip: tips?.value, icon: false },
  { key: "ship", label: c.glance.labels.cost, num: true, w: "17%", tip: null, icon: false },
];
const DEFAULT_SORT = "compounds";
// One oil, two methods: the published pair from the Index.
const pair = entries.find((e) => e.id === "olivea-ultra-high-phenolic" && e.total_secondary);
const pairBars = pair ? [
  { label: (idx.total ?? "Total, {method}").replace("{method}", pair.total_secondary!.method), v: pair.total_secondary!.value, c: "#9DAE84", hi: false },
  { label: (idx.total ?? "Total, {method}").replace("{method}", pair.method), v: pair.total!, c: "#9DAE84", hi: false },
  { label: c.number.visual?.compounds ?? "", v: pair.compounds!, c: ACCENT, hi: true },
] : [];
const pairMax = pair ? Math.max(...pairBars.map((b) => b.v)) : 1;
const bar = (v: number, dark: boolean) => `display:block; height:6px; border-radius:3px; background:${dark ? "rgba(255,250,234,.15)" : "rgba(27,66,41,.12)"}; position:relative; overflow:hidden;`;
---

<div class="relative min-h-screen">
  <Header client:load locale={locale} pageNavLayout="leading"
    pageNav={[
      { label: c.nav.glance, href: "#glance" },
      { label: c.nav.criteria, href: "#criteria" },
      { label: c.nav.table, href: "#table" },
      { label: c.nav.number, href: "#number" },
      { label: c.nav.faq, href: "#faq" },
    ]} />

  <main style={`color:${GREEN};`}>
    <!-- HERO -->
    <section class="relative flex items-center overflow-hidden" style={`background-color:${DEEP}; min-height:max(80vh, 700px);`}>
      <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="metadata" poster="/images/olives-in-container-landscape-poster.jpg" aria-hidden="true">
        <source src="/videos/olives-in-container-landscape.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(13,30,20,.78) 0%, rgba(13,30,20,.6) 50%, rgba(13,30,20,.85) 100%);"></div>
      <div class="relative container mx-auto px-6 pt-36 md:pt-44 pb-20 text-center">
        <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>{c.hero.eyebrow}</p>
        <h1 class="mx-auto mb-6" style={`font-family:${UDC}; font-weight:300; font-size:clamp(2.1rem,4.2vw,3.7rem); line-height:1.02; letter-spacing:-0.03em; color:${CREAM}; text-shadow:0 2px 24px rgba(16,34,27,.9);`}>{c.hero.h1}</h1>
        <p class="mx-auto mb-9" style={`${lead} color:rgba(255,250,234,.92); text-shadow:0 1px 12px rgba(16,34,27,.9);`}>{c.hero.lead}</p>
        <div class="flex flex-wrap justify-center gap-3 mb-10">
          <a href="#glance" style={`${btn} background-color:${ACCENT}; color:${GREEN};`}>{c.hero.cta}</a>
          <a href="#criteria" style={`${btn} background-color:rgba(255,250,234,.1); color:${CREAM}; border:1px solid rgba(255,250,234,.45); backdrop-filter:blur(6px);`}>{c.hero.ctaSecondary}</a>
        </div>
        <div class="inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-2 rounded-full px-5 py-3" style="background-color:rgba(16,34,27,.55); border:1px solid rgba(255,250,234,.28); backdrop-filter:blur(8px);">
          <span style={`${eyebrowSm} font-size:.78rem; color:${ACCENT};`}>{c.hero.updatedLabel} {c.updated}</span>
          <span class="hidden sm:inline w-px h-4" style="background-color:rgba(255,250,234,.3);"></span>
          <span style={`font-family:${SG}; font-size:.92rem; color:rgba(255,250,234,.85);`}>{c.hero.checkedLine}</span>
        </div>
        {c.siblings && c.siblings.length > 0 && (
          <p class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2">
            {c.siblings.map((s) => <a href={s.href} class="underline" style={`font-family:${SG}; font-size:.95rem; color:rgba(255,250,234,.85); text-underline-offset:4px;`}>{s.label}</a>)}
          </p>
        )}
      </div>
    </section>

    <!-- THE OILS: one card per oil, the same card as the Polyphenol Index -->
    <section id="glance" class="py-20 md:py-24 px-6 scroll-mt-24" style={`background-color:${GREEN}; color:${CREAM};`}>
      <div class="container mx-auto max-w-7xl">
        {c.glance.eyebrow && <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>{c.glance.eyebrow}</p>}
        <h2 class="mb-5" style={`${h2} color:${CREAM};`}>{c.glance.h2.replace("{n}", String(glanceRows.length))}</h2>
        <p class="mb-12" style={`${lead} color:${onGreen(0.85)};`}>{c.glance.introPre}<a href={indexHref} class="underline underline-offset-4" style={`color:${ACCENT};`}>{c.glance.introLink}</a>{c.glance.introPost}</p>
        {/* items-start: opening one card's details must not stretch its neighbour. */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
          {glanceRows.map((e, i) => {
            const mine = isMine(e); const ev = evidenceFor(e)!; const src = sourceOf(e); const per = c.oils.perOil[e.id] ?? {};
            const pros = prosOf(e); const cons = consOf(e); const p = priceInfo(e);
            return (
              <OilCard
                id={`oil-${e.id}`}
                number={String(i + 1).padStart(2, "0")}
                brand={mine ? "ATTIMO" : e.brand}
                oil={mine ? "Coratina" : e.oil}
                sub={mine ? c.glance.labels.attimoSub : [e.variety, e.origin].filter(Boolean).join(" · ")}
                image={e.image}
                imageAlt={`${e.brand} ${e.oil}`}
                tipLabel={tipLabel}
                pills={[
                  { label: methodOf(e) === "not stated" ? `${c.table.cols.method}: ${c.glance.labels.notStated}` : methodOf(e), tip: tips?.method[e.method], accent: true },
                ]}
                stats={[
                  { label: c.glance.labels.total, value: e.total !== null ? num(e.total) : "–", lines: ["mg/kg", ...(e.total_secondary ? [`${num(e.total_secondary.value)} mg/kg ${e.total_secondary.method}`] : [])], tip: tips?.total },
                  { label: c.glance.labels.compounds, value: e.compounds !== null ? num(e.compounds) : "–", lines: e.compounds !== null ? ["mg/kg", `${num(e.oleocanthal!)} oleocanthal`, `${num(e.oleacein!)} oleacein`] : ["", c.glance.labels.notStated], tip: tips?.compounds },
                ]}
                rows={[
                  { label: c.glance.labels.price, parts: [{ text: p.main }], sub: p.original || null, extra: valueOf(e) ? { text: c.glance.labels.value.replace("€", valueOf(e)), tip: tips?.value } : null },
                  { label: c.glance.labels.cost, parts: [{ text: shipLine(ev) }, ...(ev.days !== "not stated" ? [{ text: ev.days }] : [])] },
                  { label: c.glance.labels.buy, parts: [{ text: buyLabel(ev) }, ...(src.href ? [{ text: src.label, href: src.href, external: !mine }] : [])] },
                  { label: idx.harvest, parts: [{ text: e.harvest, strong: true }, e.report.status === "viewable" ? { text: idx.labReport, href: isMine(e) && e.attimo_certificate ? certHrefFor(c.lang, e.attimo_certificate) : e.reportHref, external: !mine } : { text: idx.nonePublished }] },
                ]}
              >
                <div class="oil-acc mt-1" style={`font-family:${SG}; border-top:1px solid ${onCream(0.13)};`}>
                  <details class="oil-acc-item">
                    <summary><span>{c.oils.labels.standsOut}</span><Fragment set:html={chevron} /></summary>
                    <div class="oil-acc-body"><p style={`font-size:.95rem; line-height:1.6; color:${onCream(0.85)};`}>{per.standsOut ? fill(per.standsOut) : notes[e.id] ?? e.note}</p></div>
                  </details>
                  {per.forWho && (
                    <details class="oil-acc-item">
                      <summary><span>{c.oils.labels.forWho}</span><Fragment set:html={chevron} /></summary>
                      <div class="oil-acc-body"><p class="rounded-xl px-4 py-3.5" style={`font-size:.95rem; line-height:1.55; color:${GREEN}; background-color:rgba(179,229,140,.38);`}>{per.forWho}</p></div>
                    </details>
                  )}
                  <details class="oil-acc-item">
                    <summary><span>{c.oils.labels.pros} · {c.oils.labels.cons}</span><span class="oil-acc-count" style={`color:${onCream(0.55)};`}>+{pros.length} −{cons.length}</span><Fragment set:html={chevron} /></summary>
                    <div class="oil-acc-body grid grid-cols-1 sm:grid-cols-2 gap-5">
                      <ul class="grid gap-2.5 content-start">{pros.length ? pros.map((x) => (
                        <li class="flex items-start gap-2.5" style={`font-size:.9rem; line-height:1.45; color:${GREEN};`}>
                          <span aria-hidden="true" class="flex-shrink-0 inline-flex items-center justify-center rounded-full mt-px" style="width:18px; height:18px; background-color:#1A431D;"><svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="#B3E58C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5.2 L4.2 7.3 L8 2.8" /></svg></span>
                          <span>{x}</span>
                        </li>
                      )) : <li style={`font-size:.9rem; color:${onCream(0.5)};`}>–</li>}</ul>
                      <ul class="grid gap-2.5 content-start">{cons.length ? cons.map((x) => (
                        <li class="flex items-start gap-2.5" style={`font-size:.9rem; line-height:1.45; color:${onCream(0.85)};`}>
                          <span aria-hidden="true" class="flex-shrink-0 inline-flex items-center justify-center rounded-full mt-px" style="width:18px; height:18px; background-color:#E53935;"><svg width="8" height="8" viewBox="0 0 8 8" fill="none" stroke="#FFFFFF" stroke-width="1.7" stroke-linecap="round"><path d="M1.5 1.5 L6.5 6.5 M6.5 1.5 L1.5 6.5" /></svg></span>
                          <span>{x}</span>
                        </li>
                      )) : <li style={`font-size:.9rem; color:${onCream(0.5)};`}>–</li>}</ul>
                    </div>
                  </details>

                </div>
              </OilCard>
            );
          })}
        </div>
      </div>
    </section>

    <!-- CRITERIA: what a buyer should look for -->
    <section id="criteria" class="py-20 md:py-24 px-6 scroll-mt-24" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-7xl">
        <p class="mb-5" style={`${eyebrow} color:${onCream(0.55)};`}>{c.criteria.eyebrow}</p>
        <h2 class={c.criteria.intro ? "mb-5" : "mb-12"} style={`${h2} color:${GREEN};`}>{c.criteria.h2}</h2>
        {c.criteria.intro && <p class="mb-12" style={`${lead} color:${onCream(0.78)};`}>{c.criteria.intro}</p>}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {c.criteria.items.map((it) => (
            <div class="flex gap-5 md:gap-6 p-6 md:p-8 rounded-2xl" style={`background-color:#FFFFFF; border:1px solid ${GREEN};`}>
              <span class="flex-shrink-0 inline-flex items-center justify-center rounded-full" style={`width:76px; height:76px; background-color:${ACCENT};`}>
                <span aria-hidden="true" style={`display:block; width:46px; height:46px; background-color:${GREEN}; -webkit-mask:url(${it.icon}) center/contain no-repeat; mask:url(${it.icon}) center/contain no-repeat;`}></span>
              </span>
              <div class="min-w-0">
                <p class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:1.25rem; line-height:1.2; color:${GREEN};`}>{it.title}</p>
                <p style={`${small} font-size:1rem; color:${onCream(0.8)};`}>{it.text}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- TABLE: every oil on one screen, sortable -->
    <section id="table" class="py-20 md:py-24 px-6 scroll-mt-24" style="background-color:#F3EFD9;">
      <div class="container mx-auto max-w-7xl">
        <p class="mb-5" style={`${eyebrow} color:${onCream(0.55)};`}>{c.table.eyebrow}</p>
        <h2 class="mb-5" style={`${h2} color:${GREEN};`}>{c.table.h2}</h2>
        <p class="mb-8" style={`${lead} color:${onCream(0.8)};`}>{c.table.intro}</p>

        <div class="guide-table-wrap rounded-2xl" style={`background-color:#FFFFFF; border:1px solid ${onCream(0.2)};`}>
          <table class="guide-table w-full" data-sortable style={`font-family:${SG}; border-collapse:collapse;`}>
            <thead>
              <tr>
                {COLS.map((col) => (
                  <th scope="col" class={`px-3 py-3 align-bottom ${col.num ? "text-right" : "text-left"} ${col.key === "oil" ? "guide-sticky" : ""}`} style={`border-bottom:2px dashed ${GREEN}; width:${col.w};`} aria-sort={col.key === DEFAULT_SORT ? "descending" : undefined}>
                    <span class={`inline-flex items-end gap-1 ${col.num ? "justify-end" : ""}`}>
                      <button type="button" class="guide-sort text-left" data-key={col.key} data-num={col.num ? "1" : "0"} data-tip={!col.icon && col.tip ? col.tip : undefined} style={`${eyebrowSm} font-size:.68rem; line-height:1.3; letter-spacing:.08em; color:${GREEN};`}>
                        <span class={!col.icon && col.tip ? "tip-text" : ""}>{col.label}</span><span class="guide-sort-arrow" aria-hidden="true">{col.key === DEFAULT_SORT ? " ↓" : ""}</span>
                      </button>
                      {col.icon && col.tip && <InfoTip text={col.tip} label={tl(col.label)} />}
                    </span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {glanceRows.map((e, i) => {
                const mine = isMine(e); const ev = evidenceFor(e)!; const p = priceInfo(e); const sh = shipEur(ev);
                return (
                  <tr data-order={i} data-oil={`${e.brand} ${e.oil}`} data-total={e.total ?? ""} data-compounds={e.compounds ?? ""} data-method={methodOf(e)} data-price={p.eur ?? ""} data-value={e.value_per_100mg ?? ""} data-ship={sh ?? ""} style={`border-bottom:1px dashed ${onCream(0.35)}; ${mine ? "background-color:rgba(179,229,140,.45);" : ""}`}>
                    <td class="px-3 py-3 guide-sticky" style={mine ? "background-color:#E3F3D0;" : "background-color:#FFFFFF;"}>
                      <a href={`#oil-${e.id}`} class="flex items-center gap-3 group">
                        {e.image ? <img src={e.image} alt="" width="30" height="40" loading="lazy" class="flex-shrink-0 rounded" style={`width:30px; height:40px; object-fit:cover; border:1px solid ${onCream(0.12)};`} /> : <span class="flex-shrink-0 rounded" style={`width:30px; height:40px; background-color:${onCream(0.06)};`}></span>}
                        <span class="min-w-0">
                          <span class="block group-hover:underline underline-offset-4" style={`font-family:${UDC}; font-weight:700; font-size:.98rem; line-height:1.15; color:${GREEN};`}>{mine ? "ATTIMO" : e.brand} <span style="font-weight:300;">{mine ? "Coratina" : e.oil}</span></span>
                          <span class="block" style={`font-size:.8rem; color:${onCream(0.6)};`}>{e.country}</span>
                        </span>
                      </a>
                    </td>
                    <td class="px-3 py-3 text-right whitespace-nowrap" style={`font-family:${UDC}; font-weight:700; font-size:1.05rem; color:${GREEN};`}>{e.total !== null ? num(e.total) : "–"}</td>
                    <td class="px-3 py-3 text-right whitespace-nowrap" style={`font-family:${UDC}; font-weight:700; font-size:1.05rem; color:${GREEN};`}>{e.compounds !== null ? num(e.compounds) : <span style={`color:${onCream(0.35)};`}>–</span>}</td>
                    <td class="px-3 py-3" style={`font-size:.88rem; color:${onCream(0.85)};`}><span class={tips?.method[e.method] ? "tip-text" : ""} data-tip={tips?.method[e.method]} tabindex={tips?.method[e.method] ? 0 : undefined}>{methodOf(e) === "not stated" ? c.glance.labels.notStated : methodOf(e)}</span></td>
                    <td class="px-3 py-3 text-right whitespace-nowrap" style={`font-size:.92rem; color:${GREEN};`}>{p.eur !== null ? p.short : <span style={`color:${onCream(0.35)};`}>–</span>}</td>
                    <td class="px-3 py-3 text-right whitespace-nowrap" style={`font-size:.92rem; color:${GREEN};`}>{valueOf(e) || <span style={`color:${onCream(0.35)};`}>–</span>}</td>
                    <td class="px-3 py-3" style={`font-size:.86rem; line-height:1.35; color:${onCream(0.85)};`}>{mine && c.attimoShipping?.short ? c.attimoShipping.short : shipLine(ev)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {c.table.footnotes
          ? <ul class="mt-5 grid gap-1.5 list-disc pl-5" style={`${small} font-size:.88rem; color:${onCream(0.68)};`}>{c.table.footnotes.map((f) => <li>{f.split("{checked}").join(checkedHuman).split("{verified}").join(verifiedFor(c.lang))}</li>)}</ul>
          : <p class="mt-5" style={`${small} font-size:.88rem; color:${onCream(0.65)};`}>{c.table.footnote.split("{checked}").join(checkedHuman).split("{verified}").join(verifiedFor(c.lang))}</p>}

        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-px rounded-2xl overflow-hidden" style={`background-color:rgba(255,250,234,.15);`}>
          {[{ href: indexHref, ...c.table.links.index }, { href: methodsHref, ...c.table.links.methods }].map((l) => (
            <a href={l.href} class="group flex items-start justify-between gap-6 p-7 md:p-8 transition-colors hover:bg-[#1f4b2f]" style={`background-color:${GREEN}; color:${CREAM};`}>
              <span>
                <span class="block mb-2" style={`font-family:${UDC}; font-weight:700; font-size:1.25rem; color:${CREAM};`}>{l.title}</span>
                <span class="block" style={`${small} color:${onGreen(0.78)};`}>{l.text}</span>
              </span>
              <span aria-hidden="true" class="flex-shrink-0 transition-transform group-hover:translate-x-1" style={`font-family:${UDC}; font-size:1.6rem; line-height:1; color:${ACCENT};`}>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- THE NUMBER: how to read a polyphenol figure, with one oil tested two ways -->
    <section id="number" class="py-20 md:py-28 px-6 scroll-mt-24" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-7xl">
        <p class="mb-5" style={`${eyebrow} color:${onCream(0.55)};`}>{c.number.eyebrow}</p>
        <h2 class="mb-5" style={`${h2} color:${GREEN};`}>{c.number.h2}</h2>
        <p class="mb-12" style={`${lead} color:${onCream(0.8)};`}>{c.number.intro}</p>
        <div class={c.number.visual && pair ? "grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-16 items-start" : ""}>
          <ol class={c.number.visual && pair ? "" : "grid grid-cols-1 md:grid-cols-3 gap-8"}>
            {c.number.steps.map((st, i) => (
              <li class={`grid grid-cols-[3.5rem_1fr] gap-4 ${c.number.visual && pair ? "py-6" : ""}`} style={c.number.visual && pair ? `border-top:1px solid ${onCream(0.18)};` : ""}>
                <span style={`font-family:${UDC}; font-weight:300; font-size:2.6rem; line-height:.9; letter-spacing:-0.03em; color:${onCream(0.3)};`}>{String(i + 1).padStart(2, "0")}</span>
                <span>
                  <span class="block mb-1.5" style={`font-family:${UDC}; font-weight:700; font-size:1.2rem; line-height:1.25; color:${GREEN};`}>{st.title}</span>
                  <span class="block" style={`${small} font-size:1rem; color:${onCream(0.8)};`}>{st.text}</span>
                </span>
              </li>
            ))}
            <li class={c.number.visual && pair ? "pt-6" : "md:col-span-3"} style={c.number.visual && pair ? `border-top:1px solid ${onCream(0.18)};` : ""}>
              <a href={methodsHref} class="inline-block" style={`${btn} background-color:${GREEN}; color:${CREAM};`}>{c.number.cta} →</a>
            </li>
          </ol>
          {c.number.visual && pair && (
            <figure class="rounded-2xl p-7 md:p-9" style={`background-color:${GREEN}; color:${CREAM};`}>
              <p class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:clamp(1.35rem,2.2vw,1.7rem); line-height:1.15; color:${CREAM};`}>{c.number.visual.title}</p>
              <p class="mb-8" style={`font-family:${SG}; font-size:.95rem; color:${onGreen(0.75)};`}>{pair.brand} {pair.oil} · {pair.harvest}</p>
              <div class="grid gap-6">
                {pairBars.map((b) => (
                  <div>
                    <div class="flex items-baseline justify-between gap-4 mb-2">
                      <span style={`font-family:${SG}; font-weight:600; font-size:.92rem; color:${onGreen(0.85)};`}>{b.label}</span>
                      <span style={`font-family:${UDC}; font-weight:700; font-size:1.5rem; line-height:1; color:${b.hi ? ACCENT : CREAM};`}>{num(b.v)} <span style={`font-family:${SG}; font-weight:400; font-size:.8rem; color:${onGreen(0.65)};`}>mg/kg</span></span>
                    </div>
                    <div class="rounded-full h-3" style="background-color:rgba(255,250,234,.1);">
                      <div class="rounded-full h-3" style={`width:${Math.round((b.v / pairMax) * 100)}%; background-color:${b.c};`}></div>
                    </div>
                  </div>
                ))}
              </div>
              <figcaption class="mt-8 pt-5" style={`${small} font-size:.86rem; color:${onGreen(0.65)}; border-top:1px solid rgba(255,250,234,.15);`}>{c.number.visual.caption}</figcaption>
            </figure>
          )}
        </div>
      </div>
    </section>

    <!-- AVOID -->
    <section class="py-20 md:py-24 px-6" style={`background-color:${GREEN}; color:${CREAM};`}>
      <div class="container mx-auto max-w-7xl">
        <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>{c.avoid.eyebrow}</p>
        <h2 class="mb-10" style={`${h2} color:${CREAM};`}>{c.avoid.h2}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          {c.avoid.items.map((a) => (
            <div class="p-6 rounded-2xl" style="background-color:rgba(255,250,234,.07); border:1px solid rgba(255,250,234,.2);">
              <svg viewBox="0 0 44 44" width="40" height="40" aria-hidden="true" class="mb-5" style={`color:${ACCENT};`}>
                <circle cx="22" cy="22" r="16" stroke="currentColor" stroke-width="2.2" fill="none" />
                <path d="M11 11l22 22" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
              </svg>
              <p class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:1.1rem; color:${CREAM};`}>{a.title}</p>
              <p style={`${small} color:${onGreen(0.8)};`}>{a.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div id="faq" class="scroll-mt-24">
      <FAQ client:visible locale={locale} items={c.faq.items.map((f) => ({ question: fill(f.question), answer: fill(f.answer) }))} heading={c.faq.heading} headingFontFamily={UDC} jsonLd={false} />
    </div>

    <!-- ATTIMO cards close the page: the live product cards, shipping line from the tiers -->
    <div id="attimo" class="scroll-mt-24 pb-10">
      <OilProductWidgets client:load locale={locale} heading={fill(c.attimo.h2)} headingFontFamily={UDC} subtitle={fill(c.attimo.intro)} sectionId="attimo-oils" showTagline={false} />
    </div>
    <Sonner client:load />
  </main>

  <Footer locale={locale} />
</div>

<style>
  .guide-table { table-layout: fixed; min-width: 920px; --oil-w: 28%; }
  .guide-table-wrap { overflow-x: auto; }
  .guide-sort { cursor: pointer; }
  @media (min-width: 768px) { .score-seg { flex: var(--w) 1 0; } }
  .oil-acc-item { border-bottom: 1px solid rgba(27,66,41,.13); }
  .oil-acc-item > summary {
    display: flex; align-items: center; gap: .75rem; padding: .95rem 0; cursor: pointer; list-style: none; user-select: none;
    font-family: 'UDC Working Man Sans', sans-serif; font-weight: 700; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: #1B4229;
  }
  .oil-acc-item > summary::-webkit-details-marker { display: none; }
  .oil-acc-item > summary > span:first-child { flex: 1; }
  .oil-acc-item > summary:hover { color: #10221B; }
  .oil-acc-count { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: .8rem; letter-spacing: 0; }
  .oil-acc-chev { transition: transform .2s ease; flex-shrink: 0; }
  .oil-acc-item[open] .oil-acc-chev { transform: rotate(180deg); }
  .oil-acc-body { padding: 0 0 1.1rem; }
  .guide-sort:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 1023px) {
    .guide-table { min-width: 700px; --oil-w: 150px; }
    .guide-sticky { position: sticky; left: 0; z-index: 1; box-shadow: 1px 0 0 rgba(27,66,41,.12); }
    th.guide-sticky { background: #FFFFFF; }
  }
  @media (min-width: 1024px) { .guide-table { min-width: 0; } .guide-table-wrap { overflow-x: visible; } }
</style>

<script>
  document.querySelectorAll<HTMLTableElement>("table[data-sortable]").forEach((table) => {
    const tbody = table.tBodies[0];
    let current = { key: "compounds", dir: -1 };
    const val = (tr: HTMLElement, key: string, num: boolean) => {
      const v = tr.dataset[key] ?? "";
      return num ? (v === "" ? null : parseFloat(v)) : v.toLowerCase();
    };
    const sort = (key: string, num: boolean, dir: number) => {
      const rows = Array.from(tbody.rows);
      rows.sort((a, b) => {
        const va = val(a, key, num), vb = val(b, key, num);
        if (va === null && vb === null) return Number(a.dataset.order) - Number(b.dataset.order);
        if (va === null) return 1;
        if (vb === null) return -1;
        const d = num ? ((va as number) - (vb as number)) * dir : (va as string).localeCompare(vb as string) * dir;
        if (d !== 0) return d;
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      rows.forEach((r) => tbody.appendChild(r));
      table.querySelectorAll<HTMLButtonElement>(".guide-sort").forEach((b) => {
        const on = b.dataset.key === key;
        b.closest("th")!.setAttribute("aria-sort", on ? (dir === 1 ? "ascending" : "descending") : "none");
        b.querySelector(".guide-sort-arrow")!.textContent = on ? (dir === 1 ? " ↑" : " ↓") : "";
      });
      current = { key, dir };
    };
    table.querySelectorAll<HTMLButtonElement>(".guide-sort").forEach((b) => {
      b.addEventListener("click", () => {
        const key = b.dataset.key!; const num = b.dataset.num === "1";
        // Numbers start high-first, except prices and shipping (cheapest first); text A to Z.
        const first = !num ? 1 : ["price", "value", "ship"].includes(key) ? 1 : -1;
        sort(key, num, current.key === key ? -current.dir : first);
      });
    });
  });
</script>

