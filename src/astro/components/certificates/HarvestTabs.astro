---
// The harvest switcher at the top of a per-oil certificate page. Rendered at
// the top of each harvest's hero; `active` marks that harvest's own tab.
import { ACCENT, CREAM, GREEN, SG, btn } from "@/lib/certificates/ui";

const { nav, active, label, latest } = Astro.props as {
  nav: { anchor: string; label: string }[]; active: string; label: string; latest: string;
};
---

<div class="harvest-switch mb-10 flex flex-wrap gap-3" role="tablist" aria-label={label}>
  {nav.map((tab, i) => (
    <a
      href={`#${tab.anchor}`}
      role="tab"
      aria-selected={tab.anchor === active ? "true" : "false"}
      aria-controls={tab.anchor}
      data-harvest-tab={tab.anchor}
      style={`${btn} display:inline-flex; align-items:center; gap:.6rem;`}
    >
      {tab.label}
      {i === 0 && nav.length > 1 && <span style={`font-family:${SG}; font-weight:500; font-size:.85rem; letter-spacing:0; text-transform:none;`}>{latest}</span>}
    </a>
  ))}
</div>

<style define:vars={{ cream: CREAM, green: GREEN, accent: ACCENT }}>
  .harvest-switch a { color: var(--cream); border: 1px solid rgba(255, 250, 234, .5); }
  .harvest-switch a:hover { border-color: var(--cream); }
  .harvest-switch a[aria-selected="true"] { background-color: var(--accent); color: var(--green); border-color: var(--accent); }
</style>
