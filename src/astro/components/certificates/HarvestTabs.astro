---
// The harvest switcher at the top of a per-oil certificate page. Rendered at
// the top of each harvest's hero; `active` marks that harvest's own tab.
import { CREAM, GREEN, SG, eyebrowSm, small } from "@/lib/certificates/ui";

const { nav, active, label, latest, note } = Astro.props as {
  nav: { anchor: string; label: string }[]; active: string; label: string; latest: string; note: string;
};
---

<div class="mb-10 flex flex-wrap items-center gap-x-5 gap-y-3">
  <div class="harvest-switch inline-flex flex-wrap gap-1 p-1" role="tablist" aria-label={label}>
    {nav.map((tab, i) => (
      <a
        href={`#${tab.anchor}`}
        role="tab"
        aria-selected={tab.anchor === active ? "true" : "false"}
        aria-controls={tab.anchor}
        data-harvest-tab={tab.anchor}
        style={`${eyebrowSm} font-size:.8rem; border-radius:6px; padding:.55rem .95rem; display:inline-flex; align-items:center; gap:.5rem;`}
      >
        {tab.label}
        {i === 0 && nav.length > 1 && <span style={`font-family:${SG}; font-weight:500; font-size:.72rem; letter-spacing:.02em; text-transform:none; opacity:.75;`}>{latest}</span>}
      </a>
    ))}
  </div>
  <p style={`${small} font-size:.9rem; color:rgba(255,250,234,.7);`}>{note}</p>
</div>

<style define:vars={{ cream: CREAM, green: GREEN }}>
  .harvest-switch { border: 1px solid rgba(255, 250, 234, .25); border-radius: 9px; }
  .harvest-switch a { color: rgba(255, 250, 234, .75); }
  .harvest-switch a:hover { color: var(--cream); }
  .harvest-switch a[aria-selected="true"] { background-color: var(--cream); color: var(--green); }
</style>
