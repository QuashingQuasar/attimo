---
// Body of /certificates/{id} and its localised variants.
import { Header } from "@/components/Header";
import Footer from "@astro/components/Footer.astro";
import CertificateSections from "@astro/components/certificates/CertificateSections.astro";
import { DEFAULT_LOCALE, type Locale } from "@/lib/i18n/config";
import type { Certificate } from "@/lib/certificates";
import type { CertContent } from "@/lib/certificatesContent";
import { GREEN } from "@/lib/certificates/ui";

const { cert, all, content, sentence, quality, locale = DEFAULT_LOCALE } = Astro.props as {
  cert: Certificate; all: Certificate[]; content: CertContent; sentence: string;
  quality: ReturnType<typeof import("@/lib/certificates").qualityRowsFor>; locale?: Locale;
};
---

<div class="relative min-h-screen">
  <Header client:load locale={locale} />

  <main style={`color:${GREEN};`}>
    <CertificateSections cert={cert} all={all} content={content} sentence={sentence} quality={quality} locale={locale} />
  </main>

  <Footer locale={locale} />
</div>
