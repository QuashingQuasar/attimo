---
// Body of /polyphenol-index and its localised variants. Every figure arrives
// through `ranked` and `unranked` (the polyphenol-index collection, with
// ATTIMO's row filled from the certificates collection); every string arrives
// through `content`. Charts and the matrix are built from the same data, so
// nothing on the page is a picture of a number.
import { Header } from "@/components/Header";
import { FAQ } from "@/components/FAQ";
import Footer from "@astro/components/Footer.astro";
import { DEFAULT_LOCALE, type Locale } from "@/lib/i18n/config";
import { GREEN, DEEP, CREAM, ACCENT, UDC, SG, h2, eyebrow, eyebrowSm, lead, body, small, stat, btn, cardOnCream, cardOnGreen } from "@/lib/certificates/ui";
import { verifiedFor, INDEX_NEXT, INDEX_JSON_PATH, type IndexEntry } from "@/lib/polyphenolIndex";
import type { IndexContent } from "@/lib/polyphenolIndexContent";
import { HUB_SLUGS } from "@/lib/highPolyphenolHubContent";
import { METHODS_SLUGS } from "@/lib/polyphenolMethodsContent";
import { certHrefFor } from "@/lib/certificatesContent";
import { marketGuidesFor } from "@/lib/marketGuides";

const { ranked, unranked, content: c, locale = DEFAULT_LOCALE } = Astro.props as {
  ranked: IndexEntry[];
  unranked: IndexEntry[];
  content: IndexContent;
  locale?: Locale;
};

const all = [...ranked, ...unranked];
const INDEX_VERIFIED = verifiedFor(c.lang);
const countries = new Set(all.map((e) => e.country)).size;
const maxCompounds = Math.max(...ranked.map((e) => e.compounds ?? 0));
const onCream = (a = 0.6) => `rgba(27,66,41,${a})`;
const onGreen = (a = 0.6) => `rgba(255,250,234,${a})`;
const isMine = (e: IndexEntry) => e.attimo_certificate !== null;
const ext = (e: IndexEntry) => (isMine(e) ? {} : { rel: "nofollow noopener", target: "_blank" });
const reportHref = (e: IndexEntry) => (isMine(e) && e.attimo_certificate ? certHrefFor(c.lang, e.attimo_certificate) : e.reportHref);
const methodLabel = (e: IndexEntry) => (e.method === "not stated" ? c.methodNotStated : e.method);
const note = (e: IndexEntry) => c.entryNotes[e.id] ?? e.note;
const fill = (s: string, vars: Record<string, string | number>) =>
  Object.entries(vars).reduce((acc, [k, v]) => acc.split(`{${k}}`).join(String(v)), s);

// Thousands separator by market: a comma is a DECIMAL separator in de/nl/da/sv/fr.
const GROUP: Record<string, string> = { en: ",", de: ".", nl: ".", da: ".", sv: " ", fr: " " };
const sep = GROUP[c.lang] ?? ",";
const num = (n: number) => (n >= 1000 ? `${String(n).slice(0, -3)}${sep}${String(n).slice(-3)}` : String(n));

const hubHref = HUB_SLUGS[c.lang as keyof typeof HUB_SLUGS] ?? HUB_SLUGS.en;
const methodsHref = METHODS_SLUGS[c.lang as keyof typeof METHODS_SLUGS] ?? METHODS_SLUGS.en;
const guides = marketGuidesFor(c.lang);
const submitHref = `mailto:hello@attimo-oil.com?subject=${encodeURIComponent(c.submit.mailSubject)}&body=${encodeURIComponent(c.submit.mailBody)}`;

const PAIRS = [
  { brand: "Olivea", oil: "Ultra High Phenolic", nmr: 1046, hplc: 874, pct: 20 },
  { brand: "PJ Kabos", oil: "Phenolic Shot", nmr: 1473, hplc: 995, pct: 48 },
];
const pairMax = 1473;
---

<div class="relative min-h-screen">
  <Header
    client:load
    locale={locale}
    pageNavLayout="leading"
    pageNav={[
      { label: c.nav.ranking, href: "#ranking" },
      { label: c.nav.method, href: "#method" },
      { label: c.nav.full, href: "#full-index" },
      { label: c.nav.totals, href: "#totals" },
      { label: c.nav.who, href: "#who-publishes" },
      { label: c.nav.submit, href: "#submit" },
    ]}
  />

  <main style={`color:${GREEN};`}>
    <!-- ═══ HERO: video, overlay, text ═══ -->
    <section class="relative flex items-center overflow-hidden" style={`background-color:${DEEP}; min-height:max(115vh, 1000px);`}>
      <video autoplay muted loop playsinline preload="auto" poster="/images/polyphenol-index-poster.jpg" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover" style="pointer-events:none;">
        <source src="/videos/kleia-way-video.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(13,30,20,.78) 0%, rgba(13,30,20,.58) 45%, rgba(13,30,20,.82) 100%);"></div>
      <div class="relative container mx-auto px-6 pt-36 md:pt-44 pb-20 text-center">
        <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>{c.hero.eyebrow} · {c.hero.edition}</p>
        <h1 class="mx-auto mb-6 max-w-4xl" style={`font-family:${UDC}; font-weight:300; font-size:clamp(2rem,4vw,3.4rem); line-height:1.02; letter-spacing:-0.03em; color:${CREAM}; text-shadow:0 2px 24px rgba(16,34,27,.9);`}>
          {c.hero.h1}
        </h1>
        <p class="mx-auto mb-9 max-w-2xl" style={`${lead} color:rgba(255,250,234,.92); text-shadow:0 1px 12px rgba(16,34,27,.9);`}>
          {c.hero.lead}
        </p>
        <div class="flex flex-wrap justify-center gap-3 mb-10">
          <a href="#ranking" style={`${btn} background-color:${ACCENT}; color:${GREEN};`}>{c.hero.ctaRanking}</a>
          <a href="#submit" style={`${btn} background-color:rgba(255,250,234,.1); color:${CREAM}; border:1px solid rgba(255,250,234,.45); backdrop-filter:blur(6px);`}>{c.hero.ctaSubmit}</a>
        </div>
        <!-- Living-index status chip: dot, label, note, last update. Wraps to a stacked chip on phones. -->
        <div class="inline-flex flex-wrap items-center justify-center gap-x-4 gap-y-2 rounded-full px-5 py-3" style="background-color:rgba(16,34,27,.55); border:1px solid rgba(255,250,234,.28); backdrop-filter:blur(8px);">
          <span class="inline-flex items-center gap-2.5">
            <span class="relative inline-flex w-2.5 h-2.5">
              <span class="absolute inline-flex w-full h-full rounded-full opacity-60 animate-ping" style={`background-color:${ACCENT}; animation-duration:2.4s;`}></span>
              <span class="relative inline-flex w-2.5 h-2.5 rounded-full" style={`background-color:${ACCENT};`}></span>
            </span>
            <span style={`${eyebrowSm} font-size:.78rem; color:${ACCENT};`}>{c.hero.living}</span>
          </span>
          <span class="hidden sm:inline w-px h-4" style="background-color:rgba(255,250,234,.3);"></span>
          <span style={`font-family:${SG}; font-size:.92rem; color:rgba(255,250,234,.9);`}>{c.hero.updateNote}</span>
          <span class="hidden sm:inline w-px h-4" style="background-color:rgba(255,250,234,.3);"></span>
          <span style={`font-family:${SG}; font-size:.92rem; color:rgba(255,250,234,.7);`}>{fill(c.hero.lastUpdate, { verified: INDEX_VERIFIED })}</span>
        </div>
      </div>
    </section>

    <!-- ═══ STRIP ═══ -->
    <section class="py-8 px-6" style={`background-color:${DEEP}; border-top:1px solid rgba(255,250,234,.16);`}>
      <div class="container mx-auto max-w-6xl grid grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          [c.strip.producers, fill(c.strip.producersValue, { n: all.length, c: countries })],
          [c.strip.rankedBy, c.strip.rankedByValue],
          [c.strip.everyFigure, c.strip.everyFigureValue],
          [c.strip.edition, fill(c.strip.editionValue, { edition: c.hero.edition, next: INDEX_NEXT })],
        ].map(([k, v]) => (
          <div>
            <p class="mb-1" style={`${eyebrowSm} color:${ACCENT};`}>{k}</p>
            <p style={`font-family:${SG}; font-size:1rem; color:rgba(255,250,234,.88);`}>{v}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ HOW THE RANKING WORKS ═══ -->
    <section id="method" class="py-20 md:py-24 px-6" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-6xl">
        <div class="mb-12">
          <p class="mb-5" style={`${eyebrow} color:${onCream(0.55)};`}>{c.method.eyebrow}</p>
          <h2 class="mb-6" style={`${h2} color:${GREEN};`}>{c.method.h2}</h2>
          <p style={`${lead} color:${onCream(0.8)};`}>{c.method.lead}</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.25fr] gap-6 lg:gap-8 items-stretch">
          <div class="grid grid-cols-1 gap-3 content-start">
            <p style={`${eyebrowSm} color:${onCream(0.55)};`}>{c.method.rulesLabel}</p>
            {c.method.rules.map((r, i) => (
              <div class="flex gap-4 p-5" style={cardOnCream}>
                <span class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0" style={`background-color:${GREEN}; color:${CREAM}; font-family:${UDC}; font-size:.95rem;`}>{i + 1}</span>
                <div>
                  <p class="mb-1" style={`font-family:${UDC}; font-weight:700; font-size:1.1rem; color:${GREEN};`}>{r.title}</p>
                  <p style={`${small} color:${onCream(0.8)};`}>{r.body}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="rounded-2xl p-7 md:p-9" style={`background-color:${GREEN}; color:${CREAM};`}>
            <p class="mb-1" style={`${eyebrowSm} color:${ACCENT};`}>{c.method.chartEyebrow}</p>
            <p class="mb-7" style={`font-family:${UDC}; font-weight:700; font-size:1.35rem; letter-spacing:-0.01em;`}>{c.method.chartTitle}</p>
            <div class="grid gap-3">
              {ranked.map((e) => (
                <div class="grid grid-cols-[6.5rem_1fr] sm:grid-cols-[9rem_1fr] items-center gap-3">
                  <div class="min-w-0">
                    <p class="truncate" style={`font-family:${UDC}; font-weight:700; font-size:.95rem; color:${isMine(e) ? ACCENT : CREAM};`}>{e.brand}</p>
                    <p class="truncate" style={`font-family:${SG}; font-size:.78rem; color:${onGreen(0.6)};`}>{e.oil}</p>
                  </div>
                  <div class="grid grid-cols-[1fr_7.5rem] items-center gap-3 min-w-0">
                    <div class="min-w-0"><div class="h-9 rounded-md" style={`width:${(((e.compounds ?? 0) / maxCompounds) * 100).toFixed(1)}%; background-color:${isMine(e) ? ACCENT : "rgba(255,250,234,.82)"};`}></div></div>
                    <p style={`font-family:${UDC}; font-weight:700; font-size:1.05rem; line-height:1.1;`}>{num(e.compounds!)}<span style={`display:block; font-family:${SG}; font-weight:400; font-size:.72rem; color:${onGreen(0.6)};`}>{c.method.chartTotal} {num(e.total!)} {e.method}</span></p>
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-7" style={`${small} font-size:.88rem; color:${onGreen(0.65)};`}>{c.method.chartNote}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ THE RANKED INDEX ═══ -->
    <section id="ranking" class="py-20 md:py-24 px-6 scroll-mt-24" style={`background-color:${GREEN};`}>
      <div class="container mx-auto max-w-6xl">
        <div class="mb-12">
          <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>{c.index.eyebrow}</p>
          <h2 class="mb-6" style={`${h2} color:${CREAM};`}>{fill(c.index.h2, { n: ranked.length })}</h2>
          <p style={`${lead} color:${onGreen(0.8)};`}>{c.index.lead}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {ranked.map((e) => (
            <article class="rounded-2xl p-7 md:p-8 flex flex-col min-w-0" style={`background-color:${CREAM}; color:${GREEN};`}>
              <div class="flex items-start justify-between gap-4 mb-6">
                <div class="flex items-baseline gap-4 min-w-0">
                  <span style={`font-family:${UDC}; font-weight:300; font-size:2.6rem; line-height:1; letter-spacing:-0.03em; color:${onCream(0.35)};`}>{String(e.rank).padStart(2, "0")}</span>
                  <div class="min-w-0">
                    <h3 style={`font-family:${UDC}; font-weight:700; font-size:1.5rem; letter-spacing:-0.02em; line-height:1.1; color:${GREEN}; overflow-wrap:anywhere;`}>{e.brand} <span style="font-weight:300;">{e.oil}</span></h3>
                    <p class="mt-1" style={`font-family:${SG}; font-size:.95rem; color:${onCream(0.65)};`}>{[e.variety, e.origin].filter(Boolean).join(" · ")}</p>
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2 flex-shrink-0">
                  <span class="rounded-full px-3 py-1.5" style={`${eyebrowSm} font-size:.75rem; background-color:${GREEN}; color:${CREAM};`}>{methodLabel(e)}</span>
                  {isMine(e) && <span class="rounded-full px-3 py-1.5" style={`${eyebrowSm} font-size:.75rem; background-color:${ACCENT}; color:${GREEN};`}>{c.index.ourOil}</span>}
                </div>
              </div>

              <div class="rounded-xl p-5 mb-6" style={`background-color:${GREEN}; color:${CREAM};`}>
                <p class="mb-1" style={`${eyebrowSm} color:${onGreen(0.65)};`}>{c.index.compounds}</p>
                <p style={`${stat} font-size:clamp(2.4rem,4vw,3rem); color:${ACCENT};`}>{num(e.compounds!)}<span style={`font-size:1rem; letter-spacing:0; color:${onGreen(0.8)};`}> mg/kg</span></p>
                <p class="mt-2" style={`font-family:${SG}; font-size:.95rem; color:${onGreen(0.8)};`}>{num(e.oleocanthal!)} oleocanthal · {num(e.oleacein!)} oleacein</p>
              </div>

              <dl class="grid grid-cols-2 gap-x-5 mb-6" style={`font-family:${SG}; font-size:.95rem; line-height:1.45;`}>
                {([
                  [fill(c.index.total, { method: methodLabel(e) }), e.total === null ? "—" : `${num(e.total)} mg/kg`, e.total_secondary ? fill(c.index.byMethod, { v: num(e.total_secondary.value), m: e.total_secondary.method }) : null, true],
                  [c.index.harvest, e.harvest, e.harvest_note, true],
                  [c.index.price, e.price ?? c.index.notListed, e.availability, false],
                  [c.index.labReport, null, e.report.label, false],
                ] as [string, string | null, string | null, boolean][]).map(([k, v, sub, udc]) => (
                  <div class="py-3" style="border-top:1px solid rgba(27,66,41,.15);">
                    <dt class="mb-1" style={`${eyebrowSm} font-size:.72rem; color:${onCream(0.55)};`}>{k}</dt>
                    <dd>
                      {v !== null ? <span style={udc ? `font-family:${UDC}; font-weight:700; font-size:1.15rem;` : `font-family:${SG}; font-weight:600; font-size:1rem;`}>{v}</span> : <a href={reportHref(e)} class="underline underline-offset-4" style={`font-family:${SG}; font-weight:600; font-size:1rem;`} {...ext(e)}>{e.report.status === "viewable" ? c.index.viewable : c.index.nonePublished}</a>}
                      {sub && <span style={`display:block; font-size:.85rem; color:${onCream(0.7)};`}>{sub}</span>}
                    </dd>
                  </div>
                ))}
              </dl>

              <p class="mt-auto" style={`${small} color:${onCream(0.8)};`}>{note(e)}{e.also && <span style="display:block; margin-top:.4rem;">{c.index.alsoInRange} · {e.also}</span>}</p>
            </article>
          ))}
        </div>
        <p class="mt-8" style={`${body} font-size:1.05rem; color:${onGreen(0.8)};`}>
          {fill(c.index.hubPre, { rank: ranked.find(isMine)?.rank ?? "—" })} <a href={hubHref} class="underline underline-offset-4" style={`color:${ACCENT};`}>{c.index.hubLink}</a>.
        </p>
      </div>
    </section>

    <!-- ═══ STATED TOTALS ONLY ═══ -->
    <section class="py-20 md:py-24 px-6" style="background-color:rgba(27,66,41,.05);">
      <div class="container mx-auto max-w-6xl">
        <div class="mb-10">
          <p class="mb-5" style={`${eyebrow} color:${onCream(0.55)};`}>{c.unranked.eyebrow}</p>
          <h2 class="mb-6" style={`${h2} color:${GREEN};`}>{fill(c.unranked.h2, { n: unranked.length })}</h2>
          <p style={`${lead} color:${onCream(0.78)};`}>{c.unranked.lead}</p>
        </div>
        <div class="grid grid-cols-1 gap-3">
          {unranked.map((e) => (
            <article class="grid grid-cols-1 md:grid-cols-[minmax(0,1.3fr)_auto_minmax(0,2fr)] gap-4 md:gap-8 items-start p-6" style={cardOnCream}>
              <div>
                <h3 style={`font-family:${UDC}; font-weight:700; font-size:1.25rem; letter-spacing:-0.01em; color:${GREEN};`}>{e.brand} <span style="font-weight:300;">{e.oil}</span></h3>
                <p class="mt-1" style={`font-family:${SG}; font-size:.9rem; color:${onCream(0.65)};`}>{[e.variety, e.origin].filter(Boolean).join(" · ")} · {c.unranked.harvest} {e.harvest}</p>
                <p class="mt-2" style={`font-family:${SG}; font-size:.9rem; color:${onCream(0.75)};`}>
                  <a href={reportHref(e)} class="underline underline-offset-4" {...ext(e)}>{e.report.status === "viewable" ? c.unranked.labViewable : c.unranked.noLab}</a> · {e.price ?? c.unranked.priceNotListed}{e.availability && ` · ${e.availability}`}
                </p>
              </div>
              <div class="md:text-right md:min-w-[9rem]">
                <p style={`${stat} font-size:2rem; color:${GREEN};`}>{e.total === null ? "—" : num(e.total)}<span style="font-size:.85rem; letter-spacing:0;"> mg/kg</span></p>
                <p class="mt-1" style={`${eyebrowSm} font-size:.72rem; color:${onCream(0.6)};`}>{methodLabel(e)}{e.total_secondary && ` · ${num(e.total_secondary.value)} ${e.total_secondary.method}`}</p>
              </div>
              <p style={`${small} color:${onCream(0.8)};`}>{note(e)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ FULL INDEX TABLE ═══ -->
    <section id="full-index" class="py-20 md:py-24 px-6" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-6xl">
        <div class="flex flex-wrap items-baseline justify-between gap-4 mb-10">
          <h2 style={`${h2} color:${GREEN};`}>{c.table.h2}</h2>
          <p style={`${eyebrowSm} color:${onCream(0.55)};`}>{fill(c.table.lastUpdated, { verified: INDEX_VERIFIED })}</p>
        </div>
        <div class="rounded-2xl overflow-x-auto" style={`background-color:#fff; border:1px solid rgba(27,66,41,.18);`}>
          <table class="w-full border-collapse" style={`font-family:${SG}; font-size:.95rem; min-width:820px;`}>
            <thead>
              <tr style={`background-color:${GREEN}; color:${CREAM};`}>
                {c.table.cols.map((th) => (
                  <th class="text-left p-4" style={`font-family:${UDC}; font-weight:700; font-size:.85rem; white-space:nowrap;`}>{th}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {all.map((e, i) => (
                <tr style={`border-top:1px solid rgba(27,66,41,.12); ${e.rank === null && i === ranked.length ? "border-top:2px dashed #1B4229;" : ""} ${isMine(e) ? "background-color:rgba(205,219,45,.18);" : ""}`}>
                  <td class="p-4" style={`font-family:${UDC}; color:${onCream(0.6)};`}>{e.rank ?? "—"}</td>
                  <td class="p-4 font-semibold"><a href={e.source_url} class="underline underline-offset-4 decoration-[rgba(27,66,41,.35)]" {...ext(e)}>{e.brand}</a> · {e.oil}</td>
                  <td class="p-4 font-semibold">{e.compounds === null ? <span style="opacity:.5;">{c.table.notPublished}</span> : num(e.compounds)}</td>
                  <td class="p-4">{e.total === null ? "—" : num(e.total)}{e.total_secondary && <span style="opacity:.7;"> / {num(e.total_secondary.value)}</span>}</td>
                  <td class="p-4" style="white-space:nowrap;">{e.method}{e.total_secondary && <span style="opacity:.7;"> / {e.total_secondary.method}</span>}</td>
                  <td class="p-4" style="white-space:nowrap;">{e.harvest}</td>
                  <td class="p-4"><a href={reportHref(e)} class="underline underline-offset-4" {...ext(e)}>{e.report.status === "viewable" ? c.table.viewable : c.table.none}</a></td>
                  <td class="p-4" style="min-width:12rem;">{e.price ?? c.table.notListed}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-5" style={`${small} font-size:.9rem; color:${onCream(0.6)};`}>
          {fill(c.table.footnotePre, { verified: INDEX_VERIFIED })} <a href={INDEX_JSON_PATH} class="underline">{INDEX_JSON_PATH}</a>{c.table.footnotePost}
        </p>
      </div>
    </section>

    <!-- ═══ WHY TOTALS DIFFER ═══ -->
    <section id="totals" class="py-20 md:py-24 px-6" style={`background-color:${DEEP};`}>
      <div class="container mx-auto max-w-6xl">
        <div class="mb-12">
          <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>{c.totals.eyebrow}</p>
          <h2 class="mb-6" style={`${h2} color:${CREAM};`}>{c.totals.h2}</h2>
          <p style={`${lead} color:${onGreen(0.8)};`}>{c.totals.lead}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">
          {c.totals.methods.map((m, i) => (
            <div class="rounded-2xl p-7 flex flex-col" style={i === 0 ? `background-color:${ACCENT}; color:${GREEN};` : `${cardOnGreen} color:${CREAM};`}>
              <div class="flex items-start justify-between gap-3 mb-5">
                <h3 style={`font-family:${UDC}; font-weight:700; font-size:1.4rem; letter-spacing:-0.02em; line-height:1.1; color:${i === 0 ? GREEN : CREAM};`}>{m.name}</h3>
                <span class="rounded-full px-3 py-1.5 flex-shrink-0" style={i === 0 ? `${eyebrowSm} font-size:.72rem; background-color:${GREEN}; color:${ACCENT};` : `${eyebrowSm} font-size:.72rem; background-color:rgba(255,250,234,.16); color:${CREAM};`}>{m.reading}</span>
              </div>
              <dl class="flex-1" style={`font-family:${SG}; font-size:.95rem; line-height:1.55;`}>
                {[[c.totals.rows.how, m.what], [c.totals.rows.total, m.total], [c.totals.rows.who, m.who]].map(([k, v]) => (
                  <div class="py-3" style={`border-top:1px solid ${i === 0 ? "rgba(27,66,41,.22)" : "rgba(255,250,234,.18)"};`}>
                    <dt class="mb-1" style={`${eyebrowSm} font-size:.72rem; opacity:.7;`}>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>

        <div class="rounded-2xl p-7 md:p-9 grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-8 items-center" style={`background-color:${CREAM}; color:${GREEN};`}>
          <div>
            <p class="mb-2" style={`${eyebrowSm} color:${onCream(0.55)};`}>{c.totals.pairEyebrow}</p>
            <h3 class="mb-4" style={`font-family:${UDC}; font-weight:700; font-size:1.5rem; letter-spacing:-0.02em; line-height:1.1;`}>{c.totals.pairH3}</h3>
            <p class="mb-5" style={`${body} font-size:1.02rem; color:${onCream(0.8)};`}>{c.totals.pairBody}</p>
            <a href={methodsHref} style={`${btn} background-color:${GREEN}; color:${CREAM};`}>{c.totals.methodsCta}</a>
          </div>
          <div class="grid gap-6">
            {PAIRS.map((p) => (
              <div>
                <p class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:1.05rem;`}>{p.brand} <span style={`font-weight:300; color:${onCream(0.65)};`}>{p.oil}</span> <span style={`font-family:${SG}; font-weight:400; font-size:.85rem; color:${onCream(0.6)};`}>· {fill(c.totals.apart, { pct: p.pct })}</span></p>
                {[["NMR", p.nmr, "rgba(27,66,41,.45)"], ["HPLC", p.hplc, GREEN]].map(([m, v, fillColor]) => (
                  <div class="grid grid-cols-[3.5rem_1fr_auto] items-center gap-3 mb-2">
                    <span style={`${eyebrowSm} font-size:.72rem; color:${onCream(0.6)};`}>{m}</span>
                    <div class="h-8 rounded-md" style={`width:${((Number(v) / pairMax) * 100).toFixed(1)}%; background-color:${fillColor};`}></div>
                    <span style={`font-family:${UDC}; font-weight:700; font-size:1rem; white-space:nowrap;`}>{num(Number(v))}</span>
                  </div>
                ))}
              </div>
            ))}
            <p style={`${small} font-size:.85rem; color:${onCream(0.6)};`}>{c.totals.pairNote}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ WHO PUBLISHES ═══ -->
    <section id="who-publishes" class="py-20 md:py-24 px-6" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-6xl">
        <div class="mb-12">
          <p class="mb-5" style={`${eyebrow} color:${onCream(0.55)};`}>{c.who.eyebrow}</p>
          <h2 class="mb-6" style={`${h2} color:${GREEN};`}>{c.who.h2}</h2>
          <p style={`${lead} color:${onCream(0.8)};`}>{c.who.lead}</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-6 lg:gap-8 items-start">
          <div class="rounded-2xl overflow-hidden" style={cardOnCream}>
            <table class="w-full border-collapse" style={`font-family:${SG}; font-size:.9rem;`}>
              <thead>
                <tr style={`background-color:${GREEN}; color:${CREAM};`}>
                  {c.who.cols.map((th, i) => (
                    <th class={`p-3 ${i === 0 ? "text-left" : "text-center"}`} style={`font-family:${UDC}; font-weight:700; font-size:.8rem; ${i === 0 ? "" : "width:5.5rem;"}`}>{th}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {all.map((e, i) => (
                  <tr style={`border-top:1px solid rgba(27,66,41,.12); ${e.rank === null && i === ranked.length ? "border-top:2px dashed #1B4229;" : ""} ${isMine(e) ? "background-color:rgba(205,219,45,.18);" : ""}`}>
                    <td class="p-3"><span class="font-semibold">{e.brand}</span> <span style={`color:${onCream(0.6)};`}>· {e.oil}</span></td>
                    {[e.total !== null, e.oleocanthal !== null, e.oleacein !== null, e.report.status === "viewable"].map((yes) => (
                      <td class="p-3 text-center">
                        {yes ? (
                          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-label="yes" class="inline-block"><path d="M4 10.5l4 4 8-9" stroke={GREEN} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        ) : (
                          <span aria-label="no" style={`color:${onCream(0.3)};`}>—</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="grid grid-cols-1 gap-4">
            <div class="p-6" style={`background-color:${GREEN}; color:${CREAM}; border-radius:1rem;`}>
              <p class="mb-2" style={`${eyebrowSm} color:${ACCENT};`}>{c.who.elsewhereLabel}</p>
              <p style={`${small} color:${onGreen(0.85)};`}>{c.who.elsewhereBody}</p>
            </div>
            <div class="p-6" style={cardOnCream}>
              <p class="mb-2" style={`${eyebrowSm} color:${onCream(0.55)};`}>{c.who.nothingLabel}</p>
              <p style={`${small} color:${onCream(0.85)};`}>{fill(c.who.nothingBody, { verified: INDEX_VERIFIED })}</p>
            </div>
            <div class="p-6" style={cardOnCream}>
              <p style={`${body} font-size:1.05rem; color:${GREEN};`}>{c.who.closing}</p>
            </div>
            {guides.map((guide) => (
              <a href={guide.href} class="block p-6 transition-opacity hover:opacity-90" style={`background-color:${ACCENT}; color:${GREEN}; border-radius:1rem;`}>
                <p class="mb-2" style={`${eyebrowSm} color:rgba(27,66,41,.7);`}>{guide.indexLabel}</p>
                <p class="mb-3" style={`${small} color:${GREEN};`}>{guide.indexBody}</p>
                <p style={`font-family:${UDC}; font-weight:700; color:${GREEN};`}>{guide.indexCta}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ SUBMIT ═══ -->
    <section id="submit" class="pb-6 px-6 scroll-mt-24" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-6xl">
        <div class="rounded-2xl p-10 md:p-14 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-center" style={`background-color:${GREEN};`}>
          <div>
            <p class="mb-4" style={`${eyebrow} color:${ACCENT};`}>{c.submit.eyebrow}</p>
            <h2 class="mb-4" style={`${h2} font-size:clamp(1.6rem,2.6vw,2.4rem); color:${CREAM};`}>{c.submit.h2}</h2>
            <p style={`${body} font-size:1.05rem; color:${onGreen(0.8)};`}>{c.submit.body}</p>
          </div>
          <a href={submitHref} style={`${btn} background-color:${ACCENT}; color:${GREEN}; white-space:nowrap;`}>{c.submit.cta}</a>
        </div>
      </div>
    </section>

    <!-- ═══ FAQ ═══ -->
    <FAQ client:visible locale={locale} items={c.faq.items} heading={c.faq.heading} headingFontFamily={UDC} jsonLd={false} />

    <!-- ═══ SOURCES ═══ -->
    <section class="pb-24 px-6" style={`background-color:${CREAM};`}>
      <div class="container mx-auto max-w-4xl">
        <details class="rounded-2xl overflow-hidden" style={`border:1px solid ${GREEN}; background-color:#fff;`}>
          <summary class="cursor-pointer px-6 py-5" style={`font-family:${SG}; font-weight:500; font-size:1.05rem; color:${GREEN};`}>{c.sources.summary}</summary>
          <div class="px-6 pb-6" style={`${small} color:${onCream(0.82)};`}>
            <p class="mb-4">{fill(c.sources.introPre, { verified: INDEX_VERIFIED })} <a href={certHrefFor(c.lang, "coratina-2526-hplc-2025-11")} class="underline">{c.sources.introLink}</a>{/^[.,;:]/.test(c.sources.introPost) ? "" : " "}{c.sources.introPost}</p>
            <ul class="space-y-2">
              <li>Starec et al. <a class="underline" rel="nofollow noopener" target="_blank" href="https://pmc.ncbi.nlm.nih.gov/articles/PMC7796514/">Molecules 2021;26(1):242</a></li>
              <li>Karkoula et al. <a class="underline" rel="nofollow noopener" target="_blank" href="https://pubs.acs.org/doi/10.1021/jf404421p">J. Agric. Food Chem. 2014;62:600–607</a></li>
              <li>Castillo-Luna and Priego-Capote. <a class="underline" rel="nofollow noopener" target="_blank" href="https://www.mdpi.com/2076-3921/15/4/511">Antioxidants 2026;15(4):511</a></li>
              <li>International Olive Council, <a class="underline" rel="nofollow noopener" target="_blank" href="https://www.internationaloliveoil.org/wp-content/uploads/2022/06/Doc.-No-29-REV-2_ENK.pdf">COI/T.20/Doc. No 29/Rev.2</a>; <a class="underline" rel="nofollow noopener" target="_blank" href="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32012R0432">Regulation (EU) No 432/2012</a></li>
            </ul>
          </div>
        </details>
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</div>
