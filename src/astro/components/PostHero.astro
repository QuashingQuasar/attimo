---
// Post hero: image and title side by side on a tinted band; the image overhangs the band's lower edge.
import { BLOG_TINT, BLOG_CATEGORIES } from "@/lib/blogTheme";

interface Props {
  backHref: string;
  backLabel: string;
  dateLabel: string;
  title: string;
  image?: string;
  /** Sanity category key; shown as a tag linking to the filtered index. */
  category?: string;
  lang?: string;
  /** Graphic covers keep their own shape instead of the square crop. */
  graphic?: boolean;
  aspect?: number;
}

const { backHref, backLabel, dateLabel, title, image, category, lang = "en", graphic = false, aspect } = Astro.props;
const frameStyle = graphic && aspect ? `aspect-ratio: ${aspect};` : "";
const categoryLabel = category ? (BLOG_CATEGORIES[lang] || BLOG_CATEGORIES.en)[category] : undefined;
const overhang = image ? "72px" : "0px";
---

<section
  class="px-6 md:px-12 lg:px-20 pt-28 md:pt-32"
  style={`background: linear-gradient(to bottom, ${BLOG_TINT} 0, ${BLOG_TINT} calc(100% - ${overhang}), transparent calc(100% - ${overhang}));`}
>
  <div class="max-w-6xl mx-auto">
    <a
      href={backHref}
      class="inline-flex items-center gap-2 mb-8 text-sm hover:gap-3 transition-all duration-300"
      style="font-family: 'UDC Working Man Sans', sans-serif; color: #1B422999;"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      {backLabel}
    </a>

    <div class={`grid grid-cols-1 gap-8 items-center ${image ? "md:grid-cols-2 md:gap-14" : "pb-12"}`}>
      {image && (
        <div class={`order-2 md:order-1 rounded-xl overflow-hidden ${frameStyle ? "" : "aspect-square"}`} style={frameStyle}>
          <img src={image} alt={title} class="w-full h-full object-cover" />
        </div>
      )}
      <div class="order-1 md:order-2">
        {categoryLabel && (
          <a
            href={`${backHref}?category=${category}`}
            class="post-cat inline-block mb-5 rounded-md px-3 py-1.5 text-xs transition-colors duration-200"
            style="font-family: 'UDC Working Man Sans', sans-serif; letter-spacing: 0.04em;"
          >
            {categoryLabel}
          </a>
        )}
        <span class="block text-sm tracking-wide" style="font-family: 'UDC Working Man Sans', sans-serif; color: #1B422980;">
          {dateLabel}
        </span>
        <h1
          itemprop="headline"
          class="mt-3 tracking-tight"
          style="font-family: 'UDC Working Man Sans', sans-serif; font-size: clamp(2rem, 3.4vw, 3.2rem); line-height: 1.05; color: #1B4229; text-wrap: balance;"
        >
          {title}
        </h1>
      </div>
    </div>
  </div>
</section>

<style>
  .post-cat { background: #FFFFFF; color: #1B4229; border: 1px solid #1B422940; }
  .post-cat:hover { background: #1B4229; color: #FFFAEA; border-color: #1B4229; }
</style>
