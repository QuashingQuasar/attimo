---
// Quiet line under a post title: reading time and a single share action.
interface Props {
  body: any[];
  lang: "en" | "de" | "fr" | "nl" | "da" | "sv";
  title: string;
  url: string;
}

const { body, lang, title, url } = Astro.props;

const LABELS = {
  en: { read: "min read", share: "Share", copied: "Link copied" },
  de: { read: "Min. Lesezeit", share: "Teilen", copied: "Link kopiert" },
  fr: { read: "min de lecture", share: "Partager", copied: "Lien copié" },
  nl: { read: "min leestijd", share: "Delen", copied: "Link gekopieerd" },
  da: { read: "min. læsning", share: "Del", copied: "Link kopieret" },
  sv: { read: "min läsning", share: "Dela", copied: "Länk kopierad" },
};
const l = LABELS[lang];

const words = (body || [])
  .flatMap((b: any) => (b?._type === "block" ? b.children || [] : []))
  .map((s: any) => s?.text || "")
  .join(" ")
  .split(/\s+/)
  .filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
---

<div
  class="flex items-center gap-3 mb-10 text-sm"
  style="font-family: 'UDC Working Man Sans', sans-serif; color: #1B422999;"
>
  <span>{minutes} {l.read}</span>
  <span aria-hidden="true">·</span>
  <button
    type="button"
    class="post-share underline-offset-4 hover:underline cursor-pointer"
    data-url={url}
    data-title={title}
    data-copied={l.copied}
  >
    {l.share}
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".post-share").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const { url = "", title = "", copied = "" } = btn.dataset;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          // Dismissed share sheet: nothing to do.
        }
        return;
      }
      await navigator.clipboard.writeText(url);
      const label = btn.textContent;
      btn.textContent = copied;
      setTimeout(() => (btn.textContent = label), 2000);
    });
  });
</script>
