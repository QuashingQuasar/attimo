---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import LegalPage from "@astro/react-pages/LegalPage";
import { PRIVACY } from "@/lib/legalContent";
const doc = PRIVACY.en;
---

<BaseLayout
  title={doc.metaTitle}
  description={doc.metaDescription}
  canonical="https://attimo-oil.com/privacy"
  bodyStyle="background-color: #FFFAEA;"
  hreflangPath="/privacy"
  hideAnnounceBar
>
  <LegalPage doc={doc} client:load />
</BaseLayout>
