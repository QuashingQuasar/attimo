---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import PolyphenolIndexBody from "@astro/components/PolyphenolIndexBody.astro";
import { buildIndexPage, INDEX_COVER } from "@/lib/polyphenolIndexPage";
import { INDEX_HREFLANGS } from "@/lib/polyphenolIndexContent";
import { CREAM } from "@/lib/certificates/ui";
import { DEFAULT_LOCALE } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

const locale = DEFAULT_LOCALE;
const t = getDict(locale);
const { content, ranked, unranked, canonical, description, jsonLd } = await buildIndexPage("en");
---

<BaseLayout
  title={content.meta.title}
  description={description}
  canonical={canonical}
  ogImage={INDEX_COVER}
  bodyStyle={`background-color: ${CREAM};`}
  jsonLd={jsonLd}
  hreflangs={INDEX_HREFLANGS}
  htmlLang="en"
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
>
  <PolyphenolIndexBody ranked={ranked} unranked={unranked} content={content} locale={locale} />
</BaseLayout>
