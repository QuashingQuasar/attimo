---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import { Header } from "@/components/Header";
import Footer from "@astro/components/Footer.astro";
import BlogIndexGrid from "@astro/components/BlogIndexGrid.astro";
import { getPostsByLang } from "@/lib/sanity";
import { SLUG_TO_LOCALE } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

const locale = SLUG_TO_LOCALE["dk"];
const t = getDict(locale);
const posts = await getPostsByLang("da");

---

<BaseLayout
  title="The Olive Press — ATTIMO Blog"
  description="Historier, videnskab og oprindelse bag polyfenolrig ekstra jomfruolivenolie."
  canonical="https://attimo-oil.com/dk/blog"
  htmlLang="da"
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
>
  <div class="min-h-screen flex flex-col" style="background-color: #FAF9F6;">
    <Header client:load forceScrolled locale={locale} />

    <main class="flex-1 px-6 md:px-12 lg:px-20">
      <div class="max-w-6xl mx-auto">
        <h1
          class="tracking-tight leading-[0.95]"
          style="font-family: 'Beverly Drive', cursive; font-size: clamp(3rem, 6vw, 7rem); color: #1B4229; padding-top: 200px; padding-bottom: 8px;"
        >
          The Olive Press
        </h1>

        {
          posts.length === 0 ? (
            <p class="text-center py-20 text-lg" style="font-family: 'UDC Working Man Sans', sans-serif; color: #1B422966;">
              Ingen indlæg endnu — kom snart tilbage.
            </p>
          ) : (
            <BlogIndexGrid posts={posts} base="/dk/blog" dateLocale="da-DK" />
          )
        }
      </div>
    </main>

    <Footer locale={locale} />
  </div>
</BaseLayout>
