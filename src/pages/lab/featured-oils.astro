---
// SANDBOX — experimental "featured oil" selector. NOT production.
// Isolated route, not linked from nav/footer/homepage/sitemap.
// Delete the whole `src/pages/lab/` folder to remove the experiment.
import "@astro/styles/global.css"; // self-hosted fonts (Beverly Drive, UDC) + tokens
import FeaturedOilSelector from "./_FeaturedOilSelector";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Lab — Featured Oil Selector (sandbox)</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
    />
  </head>
  <body style="background-color: #FFFAEA; margin: 0;">
    <FeaturedOilSelector client:load />
  </body>
</html>
