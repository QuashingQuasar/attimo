// of search. Delete the whole `src/pages/lab/` folder to remove the experiment.
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import FeaturedOilHome from "./_FeaturedOilHome";
---

<BaseLayout
  title="Lab — Featured Oil Selector in homepage context (sandbox)"
  description="Experimental featured-oil selector previewed inside the homepage UI."
  noIndex={true}
  bodyStyle="background-color: #FFFAEA;"
>
  <FeaturedOilHome client:load />
</BaseLayout>
