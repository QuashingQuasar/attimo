---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import { Header } from "@/components/Header";
import { FAQ } from "@/components/FAQ";
import Footer from "@astro/components/Footer.astro";

const canonical = "https://attimo-oil.com/polyphenol-methods";
const description =
  "The same olive oil scores differently on every polyphenol test. How HPLC, NMR and Folin-Ciocalteu each count, why the numbers are not comparable, and the full certificate figures for our oils.";

const GREEN = "#1B4229";
const DEEP = "#10221B";
const CREAM = "#FFFAEA";
const ACCENT = "#CDDB2D";
const UDC = "'UDC Working Man Sans', sans-serif";
const SG = "'Space Grotesk', sans-serif";

const CDN = "https://cdn.sanity.io/images/25tuybj3/production";
const IMG = {
  grove: `${CDN}/3703a62160da6e71ecf754f84fc8eb3120bb1be7-1534x1025.png`,
  mill: `${CDN}/b31742fe289abdc5b5c67a698ebd86ff50fa5bb0-1536x1024.png`,
  glasses: `${CDN}/1d8f227df9b980d80d302fea32717033dfeb3324-1535x1024.png`,
  certAnnotated: `${CDN}/82c522284004dd1a11b0787ad3124feed171e184-1360x840.png`,
  certReport: `${CDN}/4ccf1f46fbc6304c56ff8769ec7ba3b9c63c5a90-1524x1910.png`,
  medals: `${CDN}/1dfac23616e60eaff046021d2f948399d5baadee-1122x1402.png`,
  pourGlass: `${CDN}/74a87f3a2e425194f9c4e74cbc95485341f575ec-1122x1402.png`,
  doseChart: `${CDN}/4ec9c3ae1b4857690337db8b0d4138c0396bf73a-1440x760.png`,
};

// Monoline icons, drawn to match the site's line weight.
const ICON = {
  separate: `<path d="M6 10h32M6 22h32M6 34h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="14" cy="10" r="3.5" fill="currentColor"/><circle cx="26" cy="22" r="3.5" fill="currentColor"/><circle cx="20" cy="34" r="3.5" fill="currentColor"/>`,
  spectrum: `<path d="M4 30c3 0 3-12 6-12s3 8 6 8 3-16 6-16 3 20 6 20 3-9 6-9 3 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`,
  colour: `<path d="M17 5h10M19 5v11L10 32a4 4 0 003.5 6h17a4 4 0 003.5-6L25 16V5" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/><path d="M14 26h16" stroke="currentColor" stroke-width="2"/>`,
  body: `<circle cx="22" cy="22" r="15" stroke="currentColor" stroke-width="2" fill="none"/><path d="M14 22c3-5 5 5 8 0s5 5 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/>`,
  scales: `<path d="M22 8v28M12 36h20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M8 16h28M8 16l-4 8h8zM36 16l-4 8h8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/>`,
  fade: `<path d="M6 22h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M10 14v16M18 16v12M26 18v8M34 20v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>`,
  sample: `<path d="M12 6h20v30a4 4 0 01-4 4H16a4 4 0 01-4-4V6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" fill="none"/><path d="M12 24h20" stroke="currentColor" stroke-width="2"/>`,
};

// Heading style: UDC only, single font, no trailing full stop.
const h2 = `font-family:${UDC}; font-weight:300; font-size:clamp(1.9rem,3vw,3rem); line-height:1.05; letter-spacing:-0.025em;`;
const eyebrow = `font-family:${UDC}; font-size:.72rem; letter-spacing:.22em; text-transform:uppercase;`;
const lead = `font-family:${SG}; font-size:clamp(1.05rem,1.25vw,1.3rem); line-height:1.65;`;

// Chart scale must clear the largest value on the page.
const SCALE = 1700;
const w = (v: number) => ((v / SCALE) * 100).toFixed(1);

const FAQ_ITEMS = [
  {
    question: "Why do two labs report different polyphenol numbers for the same olive oil?",
    answer:
      "Because the tests count different compounds and report them in different units. The IOC's HPLC method (COI/T.20/Doc. No 29) quantifies everything against tyrosol and reports the total in tyrosol equivalents. NMR totals as published in this category are usually the hydroxytyrosol-and-derivatives figure re-expressed per kilogram, which is a narrower set of compounds on a different mass basis. Folin-Ciocalteu returns a single reducing-capacity figure in gallic or caffeic acid equivalents. A study across 50 oils found that summing individually measured compounds gave totals 1.9 to 3.0 times higher than single-number methods run on the same oils.",
  },
  {
    question: "Does NMR really read higher than HPLC?",
    answer:
      "Not as an instrument. When both techniques quantify the same compound against real standards they agree closely: a 2021 study measuring oleocanthal by NMR and by HPLC on the same oils reported 768 against 789, 724 against 739, and 283 against 259 mg/kg. The differences you see between published totals come from what is being counted and in what units, not from one machine inflating results. Treat any claim that NMR is inherently generous, or that HPLC is inherently accurate, as marketing.",
  },
  {
    question: "Why is your total 847 when the IOC method is validated to 800 mg/kg?",
    answer:
      "COI/T.20/Doc. No 29 states its range of measurement as 30 to 800 mg/kg, so our 847 sits just above the top of that validated range and should be read as an approximate figure at the boundary rather than a precise one. The certificate also states an expanded uncertainty of ±181 mg/kg. We would rather point this out ourselves than have it found. It is one of the reasons we report oleocanthal and oleacein separately, from a dedicated assay, instead of relying on a total.",
  },
  {
    question: "What is the Folin-Ciocalteu test, and is it accurate for olive oil?",
    answer:
      "It is a colour-change reaction: the reagent is reduced by phenols and the resulting colour is read on a spectrophotometer, giving one number. It responds to reducing capacity rather than to phenols specifically, so proteins, thiols, ascorbic acid and some metal ions register too — which is why EFSA considers it unsuitable for foods in general. For olive oil the same panel reached a different conclusion in 2025, judging it appropriate because the olive oil matrix lacks significant amounts of those interfering compounds. Its real limitation is scope: one number, no compounds named.",
  },
  {
    question: "Can you compare polyphenol numbers from different labs or different tests?",
    answer:
      "Totals, no — including ours against anyone else's. Individual compounds travel much better: oleocanthal measured in absolute mass by one laboratory can reasonably be set beside oleocanthal measured in absolute mass by another, because a molecule has one molecular weight whichever instrument counts it. Compare like assays, or compare named compounds, and treat any cross-method total comparison as meaningless even when it flatters us.",
  },
  {
    question: "What are oleocanthal and oleacein?",
    answer:
      "Two phenolic compounds specific to olive oil. Oleocanthal produces the peppery catch at the back of the throat and inhibits the COX-1 and COX-2 enzymes — the same mechanism as ibuprofen, at roughly a tenth of the potency by weight. It was identified precisely because a researcher noticed fresh olive oil irritated the throat the way liquid ibuprofen does. Oleacein is its close relative, built on hydroxytyrosol rather than tyrosol, and is among the most potent antioxidants identified in food. Both are specific molecules with molecular weights and reference standards, which is what makes them portable between laboratories in a way a total is not.",
  },
  {
    question: "How fast do polyphenols degrade in olive oil?",
    answer:
      "Continuously from the press onward, and faster with heat, light, oxygen and time. An opened bottle loses them more quickly than a sealed one. This is why a polyphenol figure without a harvest year and a sample date is incomplete: it describes the oil at the moment it was tested, which may be a long way behind the bottle in your kitchen.",
  },
  {
    question: "What should an olive oil lab certificate include?",
    answer:
      "The test method with its document reference, the laboratory's name, its accreditation (ISO/IEC 17025 covers testing competence and IOC recognition covers olive oil specifically; ISO 9001 is a management standard and says nothing about the assay), the sample date, and results with their units. A good certificate also states the measurement uncertainty and the limits of quantification, and reports oleocanthal and oleacein separately rather than only a total.",
  },
  {
    question: "What about LC-MS/MS?",
    answer:
      "Liquid chromatography with tandem mass spectrometry identifies compounds with the highest specificity of any of these techniques and is the benchmark the others are judged against. It appears mainly in research rather than on commercial certificates, where cost keeps it rare.",
  },
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "How olive oil polyphenols are measured: HPLC, NMR and Folin-Ciocalteu",
  description,
  url: canonical,
  inLanguage: "en",
  author: { "@type": "Organization", name: "ATTIMO", url: "https://attimo-oil.com" },
  publisher: {
    "@type": "Organization",
    name: "ATTIMO",
    url: "https://attimo-oil.com",
    logo: { "@type": "ImageObject", url: "https://attimo-oil.com/assets/navbar-logo.svg" },
  },
  image: {
    "@type": "ImageObject",
    url: IMG.grove,
    caption:
      "One Coratina olive oil on two methods: 847 mg/kg measured by HPLC, and an estimated 1,150 mg/kg by NMR, shown on a single scale.",
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout
  title="How Olive Oil Polyphenols Are Measured | HPLC, NMR and Folin | ATTIMO"
  description={description}
  canonical={canonical}
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={[articleJsonLd, faqJsonLd]}
>
  <Header client:load forceScrolled />

  <main style={`color:${GREEN};`}>
    <!-- ═══ S1 · HERO ═══ -->
    <section class="relative min-h-[78vh] flex items-end" style={`background-color:${DEEP};`}>
      <img
        src={IMG.grove}
        alt="Olive grove at dawn in warm morning mist"
        class="absolute inset-0 w-full h-full object-cover"
        style="opacity:.55;"
        width="1534" height="1025" loading="eager"
      />
      <div
        class="absolute inset-0"
        style={`background:linear-gradient(to top, ${DEEP} 12%, rgba(16,34,27,.75) 55%, rgba(16,34,27,.35) 100%);`}
      ></div>
      <div class="relative container mx-auto px-6 max-w-5xl pb-20 pt-40">
        <p class="mb-6" style={`${eyebrow} color:${ACCENT};`}>Polyphenol testing, explained</p>
        <h1 class="mb-7" style={`font-family:${UDC}; font-weight:300; font-size:clamp(2.2rem,5vw,4.2rem); line-height:1.0; letter-spacing:-0.03em; color:${CREAM};`}>
          The biggest number is not the best oil
        </h1>
        <p class="max-w-2xl mb-6" style={`${lead} color:rgba(255,250,234,.85);`}>
          Send one olive oil to three laboratories and three different numbers come back,
          because each test counts a different set of compounds in its own units.
        </p>
        <p class="max-w-3xl" style={`font-family:${SG}; font-size:1rem; line-height:1.7; color:rgba(255,250,234,.62);`}>
          HPLC is the only polyphenol test the International Olive Council recognises for
          olive oil. It separates the oil's phenols and weighs each compound on its own,
          and reports the total in tyrosol equivalents — a strict convention the IOC says
          can understate the true value. Numbers from NMR or Folin-Ciocalteu are counted
          differently and cannot be set against it.
        </p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href="#evidence" class="inline-block px-7 py-4 rounded-lg"
             style={`background-color:${ACCENT}; color:${GREEN}; font-family:${UDC}; font-size:.95rem; letter-spacing:.05em;`}>
            See the proof
          </a>
          <a href="#checklist" class="inline-block px-7 py-4 rounded-lg"
             style={`border:2px solid rgba(255,250,234,.35); color:${CREAM}; font-family:${UDC}; font-size:.95rem; letter-spacing:.05em;`}>
            How to read a label
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ S2 · HPLC vs NMR, SIDE BY SIDE ═══ -->
    <section id="evidence" class="py-20 md:py-24 px-6">
      <div class="container mx-auto max-w-5xl">
        <p class="mb-5" style={`${eyebrow} color:rgba(27,66,41,.55);`}>The evidence, side by side</p>
        <h2 class="mb-6" style={`${h2} color:${GREEN};`}>
          The same oil reads one number by HPLC and a bigger one by NMR
        </h2>
        <p class="max-w-3xl mb-12" style={`${lead} color:rgba(27,66,41,.78);`}>
          One Coratina, one sample, put through both methods, with each number labelled
          for what it is worth. Our bottle carries the conservative figure.
        </p>

        <div class="grid md:grid-cols-2 gap-5 mb-5">
          <div class="rounded-2xl p-7 md:p-9 flex flex-col" style={`background-color:${GREEN}; color:${CREAM};`}>
            <h3 class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:2rem; letter-spacing:-0.02em; color:${CREAM};`}>HPLC</h3>
            <p class="mb-6" style={`${eyebrow} color:${ACCENT};`}>The recognised method</p>
            <p class="mb-8 flex-1" style={`font-family:${SG}; font-size:1rem; line-height:1.65; color:rgba(255,250,234,.82);`}>
              Separates the oil's phenols and weighs each compound directly. The only
              method the International Olive Council recognises for olive oil biophenols
              (COI/T.20/Doc. 29).
            </p>
            <p style={`font-family:${UDC}; font-weight:300; font-size:clamp(2.8rem,6vw,4rem); line-height:1; letter-spacing:-0.04em;`}>
              847<span style="font-size:1.3rem; letter-spacing:0;"> mg/kg</span>
            </p>
            <p class="mt-4" style={`font-family:${SG}; font-size:.9rem; line-height:1.6; color:rgba(255,250,234,.65);`}>
              Measured. Chemiservice, Monopoli — ISO/IEC 17025, IOC-recognised. Report
              2533647, ±181 mg/kg.
            </p>
          </div>

          <div class="rounded-2xl p-7 md:p-9 flex flex-col" style={`background-color:rgba(27,66,41,.05); border:2px solid rgba(27,66,41,.2);`}>
            <h3 class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:2rem; letter-spacing:-0.02em; color:${GREEN};`}>NMR</h3>
            <p class="mb-6" style={`${eyebrow} color:rgba(27,66,41,.55);`}>An estimate, not a measurement</p>
            <p class="mb-8 flex-1" style={`font-family:${SG}; font-size:1rem; line-height:1.65; color:rgba(27,66,41,.78);`}>
              Reads one spectrum of the whole oil and infers a total from it. Not
              recognised by the IOC, and it counts a different set of compounds on a
              different mass basis — so it reads higher.
            </p>
            <p style={`font-family:${UDC}; font-weight:300; font-size:clamp(2.8rem,6vw,4rem); line-height:1; letter-spacing:-0.04em; color:rgba(27,66,41,.65);`}>
              ~1,150<span style="font-size:1.3rem; letter-spacing:0;"> mg/kg</span>
            </p>
            <p class="mt-4" style={`font-family:${SG}; font-size:.9rem; line-height:1.6; color:rgba(27,66,41,.6);`}>
              Estimated, not yet measured. Based on producers publishing both figures
              for one oil, where NMR lands 1.2–1.5× above HPLC. We measure ours on the
              October harvest and publish it here.
            </p>
          </div>
        </div>

        <!-- Same oil, same scale -->
        <div class="rounded-2xl p-7 md:p-9" style={`background-color:${CREAM}; border:1px solid rgba(27,66,41,.18);`}>
          <p class="mb-8" style={`${eyebrow} color:rgba(27,66,41,.55);`}>Same oil · same scale</p>

          <div class="mb-7">
            <div class="flex justify-between items-baseline mb-2" style={`font-family:${SG}; font-size:.95rem; color:${GREEN};`}>
              <span><strong>HPLC</strong> · measured</span><span class="font-bold">847 mg/kg</span>
            </div>
            <div style="background:rgba(27,66,41,.1); height:30px; border-radius:4px;">
              <div style={`background:${GREEN}; height:30px; width:${w(847)}%; border-radius:4px;`}></div>
            </div>
          </div>

          <div class="mb-8">
            <div class="flex justify-between items-baseline mb-2" style={`font-family:${SG}; font-size:.95rem; color:${GREEN};`}>
              <span><strong>NMR</strong> · estimated</span><span class="font-bold">~1,150 mg/kg</span>
            </div>
            <div style="background:rgba(27,66,41,.1); height:30px; border-radius:4px;">
              <div
                style={`height:30px; width:${w(1150)}%; border-radius:4px; background:repeating-linear-gradient(45deg, rgba(27,66,41,.32), rgba(27,66,41,.32) 8px, rgba(27,66,41,.18) 8px, rgba(27,66,41,.18) 16px);`}
              ></div>
            </div>
          </div>

          <div class="flex justify-between" style={`font-family:${SG}; font-size:.78rem; color:rgba(27,66,41,.45); border-top:1px solid rgba(27,66,41,.12); padding-top:10px;`}>
            <span>0</span><span>850</span><span>1,700 mg/kg</span>
          </div>

          <p class="mt-7" style={`font-family:${SG}; font-size:.95rem; line-height:1.7; color:rgba(27,66,41,.7);`}>
            The striped bar is an estimate, and it stays striped until the October harvest
            is tested and the measured figure replaces it.
            <a href="/lab/Coratina2025.pdf" class="underline font-medium">See the certificate →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ S3 · THREE TESTS ═══ -->
    <section class="py-20 md:py-24 px-6" style={`background-color:${GREEN};`}>
      <div class="container mx-auto max-w-6xl">
        <p class="mb-5" style={`${eyebrow} color:${ACCENT};`}>How polyphenols are measured</p>
        <h2 class="mb-6" style={`${h2} color:${CREAM};`}>
          A laboratory can count the same oil in three different ways
        </h2>
        <p class="max-w-3xl mb-12" style={`${lead} color:rgba(255,250,234,.8);`}>
          Chromatography pulls the phenols apart and weighs them one by one. Spectroscopy
          reads the whole oil at once and infers what is in it. The colorimetric test
          measures how strongly the oil reduces a reagent, which is a related but separate
          property.
        </p>

        <div class="grid md:grid-cols-3 gap-5">
          {[
            {
              name: "HPLC",
              icon: ICON.separate,
              verdict: "Weighs each compound",
              line: "Pushes the oil's phenols through a column so they arrive one at a time, then weighs each as it passes the detector.",
              reports: "Compound-by-compound, plus a total",
              ioc: "Recognised — Doc. No 29",
              hero: true,
            },
            {
              name: "NMR",
              icon: ICON.spectrum,
              verdict: "Reads the whole oil",
              line: "Takes a single magnetic resonance spectrum of the sample and assigns its peaks to known phenolic structures.",
              reports: "Selected compounds and a narrower total",
              ioc: "Not IOC recognised",
              hero: false,
            },
            {
              name: "Folin-Ciocalteu",
              icon: ICON.colour,
              verdict: "Measures a colour",
              line: "Adds a reagent that phenols turn blue, then reads the depth of that colour against a reference standard.",
              reports: "One number, no compounds named",
              ioc: "Not IOC recognised",
              hero: false,
            },
          ].map((m) => (
            <div
              class="rounded-2xl p-7"
              style={m.hero
                ? `background-color:${ACCENT}; color:${GREEN};`
                : `background-color:rgba(255,250,234,.08); color:${CREAM};`}
            >
              <div class="mb-5" style={m.hero ? "opacity:.7;" : `color:${ACCENT};`}>
                <svg width="40" height="40" viewBox="0 0 44 44" fill="none" aria-hidden="true" set:html={m.icon} />
              </div>
              <h3 class="mb-2" style={`font-family:${UDC}; font-weight:700; font-size:1.6rem; letter-spacing:-0.02em; color:${m.hero ? GREEN : CREAM};`}>
                {m.name}
              </h3>
              <p class="mb-5" style={`${eyebrow} opacity:.7;`}>{m.verdict}</p>
              <p class="mb-6" style={`font-family:${SG}; font-size:1rem; line-height:1.65; opacity:${m.hero ? ".85" : ".82"};`}>
                {m.line}
              </p>
              <dl style={`font-family:${SG}; font-size:.9rem; line-height:1.5;`}>
                <div class="py-3" style={`border-top:1px solid ${m.hero ? "rgba(27,66,41,.2)" : "rgba(255,250,234,.18)"};`}>
                  <dt style="opacity:.6;">Reports</dt>
                  <dd class="font-semibold">{m.reports}</dd>
                </div>
                <div class="py-3" style={`border-top:1px solid ${m.hero ? "rgba(27,66,41,.2)" : "rgba(255,250,234,.18)"};`}>
                  <dt style="opacity:.6;">Status</dt>
                  <dd class="font-semibold">{m.ioc}</dd>
                </div>
              </dl>
            </div>
          ))}
        </div>

        <p class="mt-10 max-w-3xl" style={`font-family:${SG}; font-size:.95rem; line-height:1.7; color:rgba(255,250,234,.62);`}>
          Folin is like counting apples by weighing the basket: the leaves and the basket
          go on the scale as well. EFSA
          <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC12099302/" class="underline" style={`color:${ACCENT};`} rel="nofollow noopener" target="_blank">rejects
          the method for foods in general</a> on those grounds, while accepting it for
          olive oil, whose matrix carries few of the compounds that interfere.
        </p>
      </div>
    </section>

    <!-- ═══ S4 · WHY HPLC ═══ -->
    <section class="py-20 md:py-24 px-6">
      <div class="container mx-auto max-w-6xl">
        <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <p class="mb-5" style={`${eyebrow} color:rgba(27,66,41,.55);`}>Our choice</p>
            <h2 class="mb-6" style={`${h2} color:${GREEN};`}>
              We test by HPLC because it names the compounds
            </h2>
            <p class="mb-10" style={`${lead} color:rgba(27,66,41,.78);`}>
              A total tells you how much phenolic material an oil carries. It cannot tell
              you which compounds, and the compounds are the entire point.
            </p>
            <div class="space-y-7">
              {[
                ["It weighs each compound separately", "Not an estimate from a spectrum and not a colour reaction. Oleocanthal and oleacein come back as their own numbers."],
                ["It is the recognised method", "The International Olive Council's official procedure for olive oil biophenols, published as COI/T.20/Doc. No 29."],
                ["It is the same test every harvest", "So our own numbers can be compared with each other year on year, which is the only comparison that holds."],
                ["It shows its own limits", "The method states its measuring range and our certificate states its uncertainty. Both appear on this page."],
              ].map(([t, b], i) => (
                <div class="flex gap-5">
                  <span style={`font-family:${UDC}; font-weight:300; font-size:1.6rem; line-height:1; color:rgba(27,66,41,.35);`}>
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3 class="mb-1.5" style={`font-family:${UDC}; font-weight:700; font-size:1.15rem; letter-spacing:-0.01em; color:${GREEN};`}>
                      {t}
                    </h3>
                    <p style={`font-family:${SG}; font-size:1rem; line-height:1.65; color:rgba(27,66,41,.75);`}>{b}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <img
            src={IMG.mill}
            alt="Fresh green olive oil flowing from a steel spout into a vat at the mill"
            class="w-full h-auto rounded-2xl"
            width="1536" height="1024" loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ═══ S5 · THE COMPOUNDS ═══ -->
    <section class="py-20 md:py-24 px-6" style="background-color:rgba(27,66,41,.05);">
      <div class="container mx-auto max-w-5xl">
