---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import { Header } from "@/components/Header";
import Footer from "@astro/components/Footer.astro";

const canonical = "https://attimo-oil.com/polyphenol-methods";
const description =
  "HPLC vs NMR vs Folin-Ciocalteu: the same olive oil scores differently on each test. What each one measures, why the numbers can't be compared, and the full certificate figures for our oils.";

// Shared scale across both inversion panels so the bars stay comparable.
const SCALE = 1300;
const w = (v: number) => ((v / SCALE) * 100).toFixed(1);

const GREEN = "#1B4229";
const CREAM = "#FFFAEA";
const ACCENT = "#CDDB2D";
const SCRIPT = "Beverly Drive, cursive";
const CAPS = "'UDC Working Man Sans', 'Space Grotesk', sans-serif";

const ANSWER =
  "HPLC is the only polyphenol test the International Olive Council recognises for olive oil. It separates and measures each compound one at a time, and reports its total in tyrosol equivalents — a strict convention the IOC itself says can understate the true value. Numbers from NMR or Folin-Ciocalteu are counted differently and cannot be compared with it.";

const FAQS = [
  {
    q: "What is the best way to test polyphenols in olive oil?",
    a: "For a number you can compare and check, HPLC. It is the basis of the International Olive Council's official method for biophenols (COI/T.20/Doc. No 29), it separates the phenolic fraction and quantifies compounds one at a time, and it can report oleocanthal and oleacein individually rather than folding them into a total. Its one quirk is the reporting convention: every compound is counted against tyrosol, a lighter molecule, so the headline total runs conservative. The IOC states this in the 2022 revision of its own document — method No 29 \"quantifies using tyrosol and therefore may underestimate the true value\".",
  },
  {
    q: "Why are NMR polyphenol numbers higher than HPLC numbers?",
    a: "Mostly because of units rather than chemistry. The IOC's HPLC method expresses its total as tyrosol equivalents, counting each compound as though it were a molecule substantially lighter than the aglycones that make up most of the phenolic fraction. NMR reports what it assigns in absolute mass. Two producers publish both figures for the same oil and show the size of the gap: one reports 850 mg/kg by HPLC and 1,046 by NMR, another 995 and 1,473. At the level of individual compounds the two techniques agree closely — a 2021 study measuring oleocanthal by both found results within about ten percent of each other.",
  },
  {
    q: "What is the Folin-Ciocalteu test, and is it accurate for olive oil?",
    a: "It is a colour-change reaction: the reagent is reduced by phenols and the resulting colour is read on a spectrophotometer, giving one number in gallic or caffeic acid equivalents. It responds to reducing capacity rather than to phenols specifically, so proteins, thiols, ascorbic acid and some metal ions also register — which is why EFSA considers it unsuitable for foods in general. For olive oil the same panel reached a different conclusion in 2025, judging the method appropriate because the olive oil matrix lacks significant amounts of those interfering compounds. Its real limitation is scope: one number, no compounds named. A 2026 study across 100 oils also found it understates real phenolic content rather than inflating it.",
  },
  {
    q: "Can you compare polyphenol numbers from different labs or different tests?",
    a: "Totals, no. A study across 50 extra virgin oils found that summing individually measured compounds returned totals 1.9 to 3.0 times higher than single-number methods run on the same oils. That is a difference in what is being counted, not in oil quality. Individual compounds travel better: oleocanthal measured in absolute mass by one laboratory can reasonably be set beside oleocanthal measured in absolute mass by another. The rule of thumb is to compare like assays, or compare named compounds, and to treat any cross-method total comparison as meaningless — including one that flatters us.",
  },
  {
    q: "What does the EU polyphenol health claim actually require?",
    a: "Regulation (EU) No 432/2012 permits the claim \"Olive oil polyphenols contribute to the protection of blood lipids from oxidative stress\" only for oil containing at least 5 mg of hydroxytyrosol and its derivatives (for example the oleuropein complex and tyrosol) per 20 g of olive oil. Two things are worth noticing. The claim is named for polyphenols in general but conditioned on one compound family. And the regulation specifies no analytical method at all, which leaves the choice of test — and therefore the size of the number — to whoever commissions it.",
  },
  {
    q: "What are oleocanthal and oleacein?",
    a: "Two phenolic compounds found in olive oil and studied more closely than any others in the fraction. Oleocanthal produces the peppery catch at the back of the throat and was identified after a researcher noticed that fresh olive oil irritated the throat the way liquid ibuprofen does; the resemblance traces to the same enzyme inhibition pathway. Oleacein is its close relative, studied chiefly as an antioxidant with cardiovascular interest. Both are specific molecules with molecular weights and reference standards, which is what makes them more portable between laboratories than a total.",
  },
  {
    q: "How fast do polyphenols degrade in olive oil?",
    a: "Continuously, from the press onward, and faster with heat, light, oxygen and time. An opened bottle loses them more quickly than a sealed one, and an oil stored warm and bright loses them more quickly than one in a cool dark cupboard. This is why a polyphenol figure without a harvest year and a sample date is incomplete: it describes the oil at the moment it was tested, which may be a long way behind the bottle in your kitchen.",
  },
  {
    q: "What should an olive oil lab certificate include?",
    a: "The test method and its document reference, the laboratory's name, its accreditation (ISO/IEC 17025 covers testing competence; IOC recognition covers olive oil specifically; ISO 9001 is a management standard and says nothing about the assay), the sample date, and the results with their units. A good certificate also states the measurement uncertainty and the limits of quantification, and reports oleocanthal and oleacein separately rather than only a total.",
  },
  {
    q: "What about LC-MS/MS?",
    a: "Liquid chromatography coupled to tandem mass spectrometry couples chromatographic separation with mass detection and identifies compounds with the highest specificity of any of these techniques. It appears mainly in research — the 2026 absolute-quantitation work is an example — rather than on commercial certificates, where cost keeps it rare. As a reference technique it is the benchmark the others are judged against.",
  },
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "HPLC vs NMR vs Folin-Ciocalteu: how olive oil polyphenols are measured",
  description,
  url: canonical,
  inLanguage: "en",
  author: { "@type": "Organization", name: "ATTIMO", url: "https://attimo-oil.com" },
  publisher: {
    "@type": "Organization",
    name: "ATTIMO",
    url: "https://attimo-oil.com",
    logo: { "@type": "ImageObject", url: "https://attimo-oil.com/assets/navbar-logo.svg" },
  },
  image: {
    "@type": "ImageObject",
    url: "https://attimo-oil.com/images/coratina-shopping.png",
    caption:
      "Two Coratina olive oils compared on total polyphenols and on oleocanthal plus oleacein. The oil with the larger total carries less of the two compounds.",
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="HPLC vs NMR vs Folin: How Olive Oil Polyphenols Are Measured | ATTIMO"
  description={description}
  canonical={canonical}
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={[articleJsonLd, faqJsonLd]}
>
  <Header client:load forceScrolled />

  <main style={`font-family: 'Space Grotesk', sans-serif; color: ${GREEN}; font-size: 18px;`}>
    <!-- ══════════ S1 · HERO ══════════ -->
    <section class="pt-32 pb-20 px-6">
      <div class="container mx-auto max-w-6xl">
        <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
          <div>
            <p class="text-xs font-bold tracking-widest uppercase mb-6" style={`font-family:${CAPS}; opacity:.55;`}>
              Polyphenol testing, explained
            </p>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] mb-6">
              The biggest number isn't the <span style={`font-family:${SCRIPT};`}>best oil.</span>
            </h1>
            <p class="text-xl leading-relaxed mb-6" style="opacity:.75;">
              The same olive oil can score 600 or 1,700 depending on the test. Here's
              what each test measures, and why we print the strictest one.
            </p>
            <p class="text-base leading-relaxed mb-8" style="opacity:.6;">
              {ANSWER}
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="#proof"
                class="inline-block text-sm font-bold px-7 py-4 rounded-xl"
                style={`background-color:${GREEN}; color:${CREAM};`}
              >
                See the proof
              </a>
              <a
                href="#checklist"
                class="inline-block text-sm font-bold px-7 py-4 rounded-xl"
                style={`border:2px solid ${GREEN};`}
              >
                How to read a label
              </a>
            </div>
          </div>
          <div class="relative">
            <img
              src="/images/coratina-shopping.png"
              alt="ATTIMO Coratina extra virgin olive oil bottle"
              width="720"
              height="720"
              class="w-full h-auto rounded-2xl"
              loading="eager"
            />
            <!-- Certificate excerpt, real values from report 2533647 -->
            <div
              class="absolute -bottom-4 -left-2 md:left-4 rounded-xl shadow-lg p-4 w-48"
              style={`background-color:${CREAM}; border:2px solid ${GREEN};`}
            >
              <p class="text-[10px] font-bold tracking-widest uppercase mb-2" style={`font-family:${CAPS}; opacity:.5;`}>
                Report 2533647
              </p>
              <dl class="text-xs space-y-1">
                <div class="flex justify-between"><dt style="opacity:.7;">Total</dt><dd class="font-bold">847 mg/kg</dd></div>
                <div class="flex justify-between"><dt style="opacity:.7;">Oleocanthal</dt><dd class="font-bold">471</dd></div>
                <div class="flex justify-between"><dt style="opacity:.7;">Oleacein</dt><dd class="font-bold">336</dd></div>
                <div class="flex justify-between"><dt style="opacity:.7;">Method</dt><dd class="font-bold">HPLC</dd></div>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ S2 · THE PROOF ══════════ -->
    <section id="proof" class="py-20 px-6" style="background-color: rgba(27,66,41,0.05);">
      <div class="container mx-auto max-w-4xl">
        <p class="text-xs font-bold tracking-widest uppercase mb-5" style={`font-family:${CAPS}; opacity:.55;`}>
          The evidence
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-5">
          Bigger number. <span style={`font-family:${SCRIPT};`}>Less of what matters.</span>
        </h2>
        <p class="text-lg leading-relaxed mb-10" style="opacity:.75;">
          Two Coratina oils. One scores higher on total polyphenols. The other has more
          of the compounds the research actually studies.
        </p>

        <figure>
          <div class="rounded-2xl p-6 md:p-8 mb-4" style={`background-color:${CREAM}; border:2px solid rgba(27,66,41,.15);`}>
            <p class="text-xs font-bold tracking-widest uppercase mb-6" style={`font-family:${CAPS}; opacity:.55;`}>
              Total polyphenols
            </p>
            <div class="mb-5">
              <div class="flex justify-between items-baseline mb-2 text-base">
                <span style="opacity:.75;">Another Coratina — NMR</span><span class="font-bold">1,295 mg/kg</span>
              </div>
              <div style="background:rgba(27,66,41,.08); height:32px; border-radius:4px;">
                <div style={`background:rgba(27,66,41,.28); height:32px; width:${w(1295)}%; border-radius:4px;`}></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2 text-base">
                <span class="font-semibold">ATTIMO Coratina — HPLC</span><span class="font-bold">847 mg/kg</span>
              </div>
              <div style="background:rgba(27,66,41,.08); height:32px; border-radius:4px;">
                <div style={`background:${GREEN}; height:32px; width:${w(847)}%; border-radius:4px;`}></div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl p-6 md:p-8" style={`background-color:${CREAM}; border:2px solid ${GREEN};`}>
            <p class="text-xs font-bold tracking-widest uppercase mb-6" style={`font-family:${CAPS}; opacity:.55;`}>
              Oleocanthal + oleacein
            </p>
            <div class="mb-5">
              <div class="flex justify-between items-baseline mb-2 text-base">
                <span class="font-semibold">ATTIMO Coratina — 471 + 336</span><span class="font-bold">807 mg/kg</span>
              </div>
              <div style="background:rgba(27,66,41,.08); height:32px; border-radius:4px;">
                <div style={`background:${GREEN}; height:32px; width:${w(807)}%; border-radius:4px;`}></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2 text-base">
                <span style="opacity:.75;">Another Coratina — 292 + 148</span><span class="font-bold">439 mg/kg</span>
              </div>
              <div style="background:rgba(27,66,41,.08); height:32px; border-radius:4px;">
                <div style={`background:rgba(27,66,41,.28); height:32px; width:${w(439)}%; border-radius:4px;`}></div>
              </div>
            </div>
          </div>

          <figcaption class="mt-5 text-base leading-relaxed" style="opacity:.65;">
            Both charts share one scale, 0–1,300 mg/kg. ATTIMO Coratina: total 847 mg/kg,
            oleocanthal 471, oleacein 336 (HPLC, Chemiservice, report 2533647). The other
            Coratina: total 1,295 mg/kg, oleocanthal 292, oleacein 148 (NMR, World Olive
            Center certificate C2526-00283). The two totals come from different tests and
            are not comparable — which is the point of this page.
            <a href="#certificates" class="underline font-medium">See both certificates</a>.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ══════════ S3 · THREE TESTS ══════════ -->
    <section class="py-20 px-6">
      <div class="container mx-auto max-w-5xl">
        <p class="text-xs font-bold tracking-widest uppercase mb-5" style={`font-family:${CAPS}; opacity:.55;`}>
          How polyphenols are measured
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-5">
          Same oil. <span style={`font-family:${SCRIPT};`}>Three tests. Three answers.</span>
        </h2>
        <p class="text-lg leading-relaxed mb-12" style="opacity:.75;">
          Each test counts something different, so the numbers can't be compared.
        </p>

        <div class="grid md:grid-cols-3 gap-5 mb-12">
          {[
            {
              name: "HPLC",
              verdict: "Measures",
              line: "Separates the oil's phenols and weighs each compound on its own.",
              chips: ["IOC recognised", "Reports each compound", "€€"],
              hero: true,
              icon: `<path d="M8 34V14m8 20V8m8 26V20m8 14V11" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M4 38h36" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>`,
            },
            {
              name: "NMR",
              verdict: "Infers",
              line: "Reads one spectrum of the whole oil and assigns the peaks to compounds.",
              chips: ["Not IOC recognised", "Totals + some compounds", "€€€"],
              hero: false,
              icon: `<circle cx="22" cy="22" r="4" stroke="currentColor" stroke-width="2.5"/><ellipse cx="22" cy="22" rx="17" ry="7" stroke="currentColor" stroke-width="2.5"/><ellipse cx="22" cy="22" rx="17" ry="7" stroke="currentColor" stroke-width="2.5" transform="rotate(60 22 22)"/><ellipse cx="22" cy="22" rx="17" ry="7" stroke="currentColor" stroke-width="2.5" transform="rotate(120 22 22)"/>`,
            },
            {
              name: "Folin",
              verdict: "Approximates",
              line: "Adds a reagent that changes colour, then reads the colour as one number.",
              chips: ["Not IOC recognised", "One number, no compounds", "€"],
              hero: false,
              icon: `<path d="M17 5h10M19 5v12L9 33a4 4 0 003 7h18a4 4 0 003-7L23 17V5" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M13 27h18" stroke="currentColor" stroke-width="2.5"/>`,
            },
          ].map((m) => (
            <div
              class="rounded-2xl p-6"
              style={m.hero
                ? `background-color:${GREEN}; color:${CREAM};`
                : `background-color:rgba(27,66,41,.05); border:1px solid rgba(27,66,41,.12);`}
            >
              <div class="mb-4" style={m.hero ? `color:${ACCENT};` : "opacity:.65;"}>
                <svg width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true" set:html={m.icon} />
              </div>
              <div class="flex items-baseline gap-2 mb-3 flex-wrap">
                <h3 class="text-2xl font-bold">{m.name}</h3>
                <span
                  class="text-xs font-bold tracking-wider uppercase px-2 py-1 rounded-full"
                  style={m.hero
                    ? `background-color:${ACCENT}; color:${GREEN}; font-family:${CAPS};`
                    : `background-color:rgba(27,66,41,.1); font-family:${CAPS};`}
                >
                  {m.verdict}
                </span>
              </div>
              <p class="leading-relaxed mb-5 text-base" style="opacity:.8;">{m.line}</p>
              <ul class="space-y-2 text-sm">
                {m.chips.map((c) => (
                  <li
                    class="inline-block mr-2 mb-2 px-3 py-1 rounded-full"
                    style={m.hero ? "background-color:rgba(255,250,234,.15);" : "background-color:rgba(27,66,41,.07);"}
                  >
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Real dual-method data: two producers publishing both numbers -->
        <div class="rounded-2xl p-6 md:p-8" style="background-color:rgba(27,66,41,.05);">
          <p class="text-xs font-bold tracking-widest uppercase mb-6" style={`font-family:${CAPS}; opacity:.55;`}>
            One oil, two tests — as published by the producers
          </p>
          <div class="grid sm:grid-cols-2 gap-8">
            {[
              { who: "A Messinian producer", hplc: 850, nmr: 1046 },
              { who: "A Peloponnese producer", hplc: 995, nmr: 1473 },
            ].map((p) => (
              <div>
                <p class="text-base font-semibold mb-4">{p.who}</p>
                <div class="mb-3">
                  <div class="flex justify-between text-sm mb-1"><span style="opacity:.7;">HPLC</span><span class="font-bold">{p.hplc.toLocaleString()} mg/kg</span></div>
                  <div style="background:rgba(27,66,41,.08); height:20px; border-radius:3px;">
                    <div style={`background:${GREEN}; height:20px; width:${w(p.hplc)}%; border-radius:3px;`}></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-sm mb-1"><span style="opacity:.7;">NMR</span><span class="font-bold">{p.nmr.toLocaleString()} mg/kg</span></div>
                  <div style="background:rgba(27,66,41,.08); height:20px; border-radius:3px;">
                    <div style={`background:rgba(27,66,41,.28); height:20px; width:${w(p.nmr)}%; border-radius:3px;`}></div>
                  </div>
                </div>
              </div>
            ))}
          </div>
          <p class="mt-6 text-base leading-relaxed" style="opacity:.65;">
            Same oil, same harvest, both numbers published by the producer. The gap is
            the test, not the oil.
          </p>
        </div>

        <div class="mt-10 rounded-2xl p-6 md:p-8" style={`background-color:${GREEN}; color:${CREAM};`}>
          <p class="text-xl md:text-2xl leading-snug font-semibold">
            Folin is like counting apples by weighing the basket. The leaves and the
            basket get weighed too.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ S4 · WHY HPLC ══════════ -->
    <section class="py-20 px-6" style={`background-color:${GREEN}; color:${CREAM};`}>
      <div class="container mx-auto max-w-5xl">
        <p class="text-xs font-bold tracking-widest uppercase mb-5" style={`font-family:${CAPS}; opacity:.6;`}>
          Our choice
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-12">
          Why we test with <span style={`font-family:${SCRIPT}; color:${ACCENT};`}>HPLC.</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-5">
          {[
            ["It measures each compound.", "Not an estimate from a spectrum, and not a colour reaction. Every phenol is separated and weighed on its own."],
            ["It's the official method.", "The International Olive Council recognises it for olive oil biophenols, as COI/T.20/Doc. No 29."],
            ["It shows what matters.", "Oleocanthal and oleacein reported as their own line items, rather than buried inside one total."],
            ["It's comparable.", "The same test every harvest, so our numbers can be set against each other year to year."],
          ].map(([t, b], i) => (
            <div class="rounded-2xl p-6" style="background-color:rgba(255,250,234,.07);">
              <span class="text-3xl font-bold block mb-3" style={`color:${ACCENT}; font-family:${CAPS};`}>
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="text-lg font-bold mb-2">{t}</h3>
              <p class="leading-relaxed text-base" style="opacity:.8;">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ S5 · THE COMPOUNDS ══════════ -->
    <section class="py-20 px-6">
      <div class="container mx-auto max-w-5xl">
        <p class="text-xs font-bold tracking-widest uppercase mb-5" style={`font-family:${CAPS}; opacity:.55;`}>
          Beyond the total
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-5">
          The compounds that <span style={`font-family:${SCRIPT};`}>actually matter.</span>
        </h2>
        <p class="text-lg leading-relaxed mb-12" style="opacity:.75;">
          The EU health claim isn't about "polyphenols" in general. It names specific compounds.
        </p>

        <div class="grid md:grid-cols-2 gap-5 mb-8">
          {[
            {
              name: "Oleocanthal",
              what: "The peppery catch at the back of your throat when you taste fresh oil.",
              why: "Studied for anti-inflammatory activity through the same enzyme pathway as ibuprofen.",
              value: "471 mg/kg",
            },
            {
              name: "Oleacein",
              what: "Oleocanthal's close relative, with no comparable taste signature.",
              why: "Studied chiefly as an antioxidant, with cardiovascular interest.",
              value: "336 mg/kg",
            },
          ].map((c) => (
            <div class="rounded-2xl p-7" style="background-color:rgba(27,66,41,.05); border:1px solid rgba(27,66,41,.12);">
              <h3 class="text-2xl font-bold mb-4">{c.name}</h3>
              <p class="leading-relaxed mb-3 text-base" style="opacity:.8;">{c.what}</p>
              <p class="leading-relaxed mb-6 text-base" style="opacity:.8;">{c.why}</p>
              <div class="pt-5" style="border-top:1px solid rgba(27,66,41,.15);">
                <span class="text-xs font-bold tracking-widest uppercase block mb-1" style={`font-family:${CAPS}; opacity:.5;`}>
                  In our Coratina
                </span>
                <span class="text-3xl font-bold">{c.value}</span>
              </div>
            </div>
          ))}
        </div>

        <p class="text-base leading-relaxed" style="opacity:.65;">
          The EU claim covers hydroxytyrosol and its derivatives — for example the
          oleuropein complex and tyrosol — at 5 mg per 20 g of oil, under
          <a
            href="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX%3A32012R0432"
            class="underline font-medium" rel="nofollow noopener" target="_blank">
            Regulation (EU) No 432/2012</a>. These compounds are studied, not proven remedies.
        </p>
      </div>
    </section>

    <!-- ══════════ S6 · HONEST LIMITS ══════════ -->
    <section class="py-20 px-6" style="background-color:rgba(27,66,41,.05);">
      <div class="container mx-auto max-w-5xl">
        <p class="text-xs font-bold tracking-widest uppercase mb-5" style={`font-family:${CAPS}; opacity:.55;`}>
          What we won't claim
        </p>
        <h2 class="text-3xl md:text-4xl font-bold mb-12">
          What no lab can <span style={`font-family:${SCRIPT};`}>tell you yet.</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-5">
          {[
            {
              t: "Your body converts some compounds.",
              b: "Precursors turn into hydroxytyrosol and tyrosol as you digest them. No test at bottling captures that.",
