---
// Design prototype: the real product page in the renewed look, for Peranzana.
// Peranzana is not in Shopify yet, so a stand-in product (Nocellara's record,
// renamed, in stock, price from the content's look) feeds the page; the copy comes from
// productContent["peranzana"]. Not indexed, not linked.
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import ProductPageWrapper from "@astro/react-pages/ProductPageWrapper";
import { fetchProducts } from "@/lib/shopify";
import { sanityClient } from "@/lib/sanity";
import { DEFAULT_LOCALE } from "@/lib/i18n/config";
import peranzanaCutout from "@/assets/bottle-2627-peranzana.png?url";

const locale = DEFAULT_LOCALE;
const [allProducts, blogPosts] = await Promise.all([
  fetchProducts(50).catch(() => []),
  sanityClient.fetch(`*[_type == "post" && coalesce(language, "en") == "en"] | order(publishedAt desc)[0..2] { _id, title, slug, publishedAt, excerpt, coverImage }`).catch(() => []),
]);
const base = allProducts.find((p) => p.node.handle === "nocellara");
const mockProduct = base ? {
  node: {
    ...base.node,
    id: "prototype-peranzana",
    handle: "peranzana",
    title: "ATTIMO Extra Virgin Olive Oil Peranzana 500ml",
    images: { edges: [{ node: { url: peranzanaCutout, altText: "ATTIMO Peranzana 26/27" } }] },
    variants: { edges: base.node.variants.edges.map((v) => ({ node: { ...v.node, id: "prototype-peranzana-variant", availableForSale: true } })) },
  },
} : undefined;
---

<BaseLayout
  title="Peranzana d'Italia (prototype) | ATTIMO"
  description="Design prototype of the Peranzana product page in the renewed look."
  canonical="https://attimo-oil.com/prototype/pdp-peranzana"
  bodyStyle="background-color: #FFFAEA;"
  htmlLang="en"
  noIndex={true}
>
  <ProductPageWrapper handle="peranzana" initialProducts={allProducts} initialBlogPosts={blogPosts} locale={locale} mockProduct={mockProduct} client:load />
</BaseLayout>
