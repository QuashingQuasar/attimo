---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import NewHarvestPage from "@astro/react-pages/NewHarvestPage";
import { NH_CONTENT, NH_SLUGS } from "@/lib/newHarvestContent";
import { HARVEST_STATUS } from "@/lib/harvestStatus";
import { getHomeLabNumbers } from "@/lib/certificates/homeNumbers";
import { DEFAULT_LOCALE } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

const locale = DEFAULT_LOCALE;
const t = getDict(locale);
const content = NH_CONTENT.en;
const canonical = `https://attimo-oil.com${NH_SLUGS.en}`;
const labNumbers = await getHomeLabNumbers();

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: content.hero.h1,
  url: canonical,
  description: content.meta.description,
  dateModified: HARVEST_STATUS.updated,
  publisher: { "@type": "Organization", name: "ATTIMO", url: "https://attimo-oil.com" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.items.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
  canonical={canonical}
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={[pageJsonLd, faqJsonLd]}
  htmlLang="en"
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
>
  <NewHarvestPage locale={locale} labNumbers={labNumbers} client:load />
</BaseLayout>
