---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import CertificateBody from "@astro/components/certificates/CertificateBody.astro";
import OilCertificatesBody from "@astro/components/certificates/OilCertificatesBody.astro";
import { getCertificates, type Certificate, type Oil } from "@/lib/certificates";
import { buildCertificatePage, buildOilPage, buildPendingOilPage, getCertificateOils, getPendingOils, type PendingOil } from "@/lib/certificatesPage";
import { certHreflangs } from "@/lib/certificatesContent";
import { CREAM } from "@/lib/certificates/ui";
import { SLUG_TO_LOCALE } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

export async function getStaticPaths() {
  const certs = await getCertificates();
  // One page per report, plus one per oil (/certificates/coratina) with a tab per harvest.
  return [
    ...certs.map((c) => ({ params: { id: c.id }, props: { cert: c } })),
    ...(await getCertificateOils()).map(({ oil }) => ({ params: { id: oil }, props: { oil } })),
    ...(await getPendingOils()).map((p) => ({ params: { id: p.slug }, props: { pending: p } })),
  ];
}

const { cert, oil, pending } = Astro.props as { cert?: Certificate; oil?: Oil; pending?: PendingOil };
const locale = SLUG_TO_LOCALE["de"];
const t = getDict(locale);
const oilPage = oil ? await buildOilPage(oil, "de") : null;
const certPage = cert ? await buildCertificatePage(cert, "de") : null;
const pendingPage = pending ? buildPendingOilPage(pending, "de") : null;
const page = (oilPage ?? certPage ?? pendingPage)!;
---

<BaseLayout
  title={page.metaTitle}
  description={certPage ? certPage.sentence : (oilPage ?? pendingPage)!.metaDescription}
  canonical={page.canonical}
  bodyStyle={`background-color: ${CREAM};`}
  jsonLd={page.jsonLd}
  hreflangs={certHreflangs(oil ?? pending?.slug ?? cert!.id)}
  htmlLang={locale.lang}
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
>
  {pendingPage
    ? <OilCertificatesBody tabs={[]} all={[]} content={pendingPage.t} locale={locale} pending={pendingPage.tab} />
    : oilPage
    ? <OilCertificatesBody tabs={oilPage.tabs} all={oilPage.all} content={oilPage.t} locale={locale} />
    : <CertificateBody cert={cert!} all={certPage!.all} content={certPage!.t} sentence={certPage!.sentence} quality={certPage!.quality} locale={locale} />}
</BaseLayout>
