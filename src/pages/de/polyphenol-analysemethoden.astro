---
// DE-language variant of the polyphenol-methods page. Same body
// component; copy comes from METHODS_CONTENT.de. Translated slug so it ranks
// the DE keyword cluster.
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import PolyphenolMethodsBody from "@astro/components/PolyphenolMethodsBody.astro";
import {
  METHODS_CONTENT,
  METHODS_SLUGS,
  METHODS_HREFLANGS,
} from "@/lib/polyphenolMethodsContent";
import { getCertificateMap, fillMethodsContent } from "@/lib/certificates";
import { SLUG_TO_LOCALE } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

const locale = SLUG_TO_LOCALE["de"];
const certs = await getCertificateMap();
const content = fillMethodsContent(METHODS_CONTENT.de, certs);
const t = getDict(locale);
const canonical = `https://attimo-oil.com${METHODS_SLUGS.de}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: content.meta.headline,
  description: content.meta.description,
  url: canonical,
  inLanguage: content.lang,
  author: { "@type": "Organization", name: "ATTIMO", url: "https://attimo-oil.com" },
  publisher: {
    "@type": "Organization",
    name: "ATTIMO",
    url: "https://attimo-oil.com",
    logo: { "@type": "ImageObject", url: "https://attimo-oil.com/assets/navbar-logo.svg" },
  },
  image: {
    "@type": "ImageObject",
    url: "https://cdn.sanity.io/images/25tuybj3/production/3703a62160da6e71ecf754f84fc8eb3120bb1be7-1534x1025.png",
    caption: content.meta.imageCaption,
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faq.items.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
  canonical={canonical}
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={[articleJsonLd, faqJsonLd]}
  hreflangs={METHODS_HREFLANGS}
  htmlLang={content.lang}
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
>
  <PolyphenolMethodsBody content={content} locale={locale} certs={certs} />
</BaseLayout>
