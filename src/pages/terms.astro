---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import LegalPage from "@astro/react-pages/LegalPage";
import { TERMS } from "@/lib/legalContent";
const doc = TERMS.en;
---

<BaseLayout
  title={doc.metaTitle}
  description={doc.metaDescription}
  canonical="https://attimo-oil.com/terms"
  bodyStyle="background-color: #FFFAEA;"
  hreflangPath="/terms"
  hideAnnounceBar
>
  <LegalPage doc={doc} client:load />
</BaseLayout>
