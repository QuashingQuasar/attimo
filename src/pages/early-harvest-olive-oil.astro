---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import EarlyHarvestPage from "@astro/react-pages/EarlyHarvestPage";
import { sanityClient } from "@/lib/sanity";
import { EARLY_HARVEST_FAQS } from "@/lib/earlyHarvestContent";
import { HIGH_POLYPHENOL_PRODUCTS } from "@/lib/highPolyphenolContent";

const canonical = "https://attimo-oil.com/early-harvest-olive-oil";
const description =
  "Shop early harvest olive oil — single-variety, green-picked and pressed fresh for maximum flavour and polyphenols. Only ever this year's harvest. From €22.";

// CollectionPage + ItemList: the three single-variety oils.
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Early Harvest Olive Oil",
  url: canonical,
  description,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: HIGH_POLYPHENOL_PRODUCTS.length,
    itemListElement: HIGH_POLYPHENOL_PRODUCTS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Product",
        name: p.name,
        url: p.url,
        image: p.image,
        brand: { "@type": "Brand", name: "ATTIMO" },
        offers: {
          "@type": "Offer",
          url: p.url,
          price: p.priceEUR.toFixed(2),
          priceCurrency: "EUR",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
        },
      },
    })),
  },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: EARLY_HARVEST_FAQS.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};

// Curated feed: harvest/freshness-relevant posts.
const CURATED_POST_SLUGS = [
  "olive-color-ripeness-polyphenols",
  "unfiltered-olive-oil",
  "polyphenols-olive-oil",
  "how-to-read-olive-oil-lab-analysis",
];
const curatedPosts = await sanityClient.fetch(
  `*[_type == "post" && slug.current in $slugs] | order(publishedAt desc)[0..2] {
    _id, title, slug, publishedAt, excerpt, coverImage
  }`,
  { slugs: CURATED_POST_SLUGS }
);
---

<BaseLayout
  title="Early Harvest Olive Oil | Green-Picked, Fresh-Pressed"
  description={description}
  canonical={canonical}
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={[collectionJsonLd, faqJsonLd]}
>
  {/*
    English-only for v1, same as the high-polyphenol hub. FR/DE would plug into
    the [locale] routing the same way (getStaticPaths over LOCALES, translated
    copy via a dictionary section, hreflangPath + pathHasLocaleVariants).
  */}
  <EarlyHarvestPage initialPosts={curatedPosts} client:load />
</BaseLayout>
