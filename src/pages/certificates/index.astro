---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import { Header } from "@/components/Header";
import Footer from "@astro/components/Footer.astro";
import { DEFAULT_LOCALE } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";
import {
  getCertificates,
  certificatePath,
  certificateDate,
  certificatesIndexPath,
  formatDate,
  oilTitle,
  labLine,
  OIL_ORDER,
  OIL_NAMES,
  SITE,
} from "@/lib/certificates";
import { GREEN, CREAM, ACCENT, UDC, SG, h1, eyebrow, eyebrowSm, lead, body, small, stat, cardOnCream } from "@/lib/certificates/ui";

const locale = DEFAULT_LOCALE;
const t = getDict(locale);
const certs = await getCertificates();
const canonical = `${SITE}${certificatesIndexPath}`;

// Oil → harvest → certificates (newest first, as the collection is sorted).
const byOil = OIL_ORDER.map((oil) => {
  const mine = certs.filter((c) => c.oil === oil);
  const harvests = [...new Set(mine.map((c) => c.harvest))];
  return { oil, name: OIL_NAMES[oil], harvests: harvests.map((h) => ({ harvest: h, certs: mine.filter((c) => c.harvest === h) })) };
}).filter((o) => o.harvests.length);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "ATTIMO laboratory certificates",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: certs.length,
    itemListElement: certs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: oilTitle(c), url: `${SITE}${certificatePath(c.id)}` })),
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "ATTIMO olive oil laboratory certificates",
    description: "Every laboratory result ATTIMO has published — polyphenol totals, oleocanthal, oleacein and quality parameters — with the method, laboratory, dates and original PDF for each.",
    url: canonical,
    license: "https://creativecommons.org/licenses/by/4.0/",
    creator: { "@type": "Organization", name: "ATTIMO", url: SITE },
    distribution: [{ "@type": "DataDownload", encodingFormat: "application/json", contentUrl: `${SITE}/certificates/index.json` }],
  },
];
---

<BaseLayout
  title="Every ATTIMO lab result, published | Polyphenol certificates"
  description="Every ATTIMO olive oil, every harvest, every test, with the original laboratory documents: total phenols, oleocanthal, oleacein, method, lab and dates."
  canonical={canonical}
  bodyStyle={`background-color: ${CREAM};`}
  jsonLd={jsonLd}
  htmlLang="en"
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
>
  <div class="relative min-h-screen">
    <Header client:load locale={locale} />

    <main style={`color:${GREEN};`}>
      <section class="px-6 pb-14" style={`background-color:${GREEN}; padding-top:124px;`}>
        <div class="container mx-auto max-w-5xl pt-10">
          <p class="mb-4" style={`${eyebrow} color:${ACCENT};`}>Lab certificates</p>
          <h1 class="mb-5" style={`${h1} color:${CREAM};`}>Every lab result, published</h1>
          <p class="max-w-3xl" style={`${lead} color:rgba(255,250,234,.88);`}>
            Every ATTIMO oil, every harvest, every test, with the original documents.
          </p>
        </div>
      </section>

      <section class="py-16 md:py-20 px-6" style={`background-color:${CREAM};`}>
        <div class="container mx-auto max-w-5xl">
          {byOil.map((o) => (
            <div class="mb-14">
              <h2 class="mb-6" style={`font-family:${UDC}; font-weight:300; font-size:clamp(1.8rem,2.8vw,2.6rem); letter-spacing:-0.025em; color:${GREEN};`}>{o.name}</h2>
              {o.harvests.map((h) => (
                <div class="mb-6">
                  <p class="mb-4" style={`${eyebrowSm} color:rgba(27,66,41,.55);`}>Harvest {h.harvest}</p>
                  <div class="grid md:grid-cols-2 gap-5">
                    {h.certs.map((c) => (
                      <a href={certificatePath(c.id)} class="block p-7 transition-shadow hover:shadow-lg" style={cardOnCream}>
                        <div class="flex items-baseline justify-between gap-4 mb-4">
                          <p style={`font-family:${UDC}; font-weight:700; font-size:1.2rem; color:${GREEN};`}>{oilTitle(c)}</p>
                          <span class="px-3 py-1 rounded-full" style={`${eyebrowSm} font-size:.72rem; background-color:${GREEN}; color:${CREAM};`}>{c.method.name}</span>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-5">
                          <div>
                            <p style={`${stat} font-size:2.4rem; color:${GREEN};`}>{c.phenolics.total ?? "—"}<span style="font-size:.9rem; letter-spacing:0;"> mg/kg</span></p>
                            <p class="mt-1" style={`${eyebrowSm} font-size:.72rem; color:rgba(27,66,41,.6);`}>Total phenols{c.phenolics.total_expressed_as ? ` · as ${c.phenolics.total_expressed_as}` : ""}</p>
                          </div>
                          {c.oleocanthal_plus_oleacein !== null ? (
                            <div>
                              <p style={`${stat} font-size:2.4rem; color:${GREEN};`}>{c.oleocanthal_plus_oleacein}<span style="font-size:.9rem; letter-spacing:0;"> mg/kg</span></p>
                              <p class="mt-1" style={`${eyebrowSm} font-size:.72rem; color:rgba(27,66,41,.6);`}>Oleocanthal + oleacein</p>
                            </div>
                          ) : (
                            <div>
                              <p style={`font-family:${SG}; font-size:.95rem; line-height:1.5; color:rgba(27,66,41,.65);`}>No individual compounds on this method</p>
                            </div>
                          )}
                        </div>
                        <p style={`${small} color:rgba(27,66,41,.7);`}>
                          {labLine(c)} · {c.certificate.sample_date ? `sampled ${formatDate(c.certificate.sample_date)}` : `sample received ${formatDate(certificateDate(c))}`}
                        </p>
                        <p class="mt-3 underline" style={`${small} color:${GREEN};`}>Read the certificate →</p>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ))}

          <div class="rounded-2xl p-8 md:p-10" style="background-color:rgba(27,66,41,.05);">
            <p class="mb-3" style={`${eyebrowSm} color:rgba(27,66,41,.55);`}>How to read them</p>
            <p class="mb-4" style={`${body} color:rgba(27,66,41,.82);`}>
              Totals from HPLC, NMR and Folin-Ciocalteu cannot be set beside each other. Oleocanthal and oleacein can.
            </p>
            <a href="/polyphenol-methods" class="underline" style={`font-family:${SG}; font-size:1.05rem; color:${GREEN};`}>Polyphenol analysis methods explained →</a>
            <p class="mt-6" style={`${small} font-size:.85rem; color:rgba(27,66,41,.6);`}>Machine-readable: <a class="underline" href="/certificates/index.json">index.json</a></p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
