---
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import ShippingPage from "@astro/react-pages/ShippingPage";
import { LOCALES, type Locale } from "@/lib/i18n/config";
import { getDict } from "@/lib/i18n/dictionaries";

export function getStaticPaths() {
  return LOCALES
    .filter((l) => l.slug !== "")
    .map((locale) => ({
      params: { locale: locale.slug },
      props: { locale },
    }));
}

const { locale } = Astro.props as { locale: Locale };
const canonical = `https://attimo-oil.com/${locale.slug}/shipping`;
const t = getDict(locale);
---

<BaseLayout
  title={t.meta.shipping.title}
  description={t.meta.shipping.description}
  canonical={canonical}
  bodyStyle="background-color: #FFFAEA;"
  hreflangPath="/shipping"
  htmlLang={locale.lang}
  announceTier2={t.announce.freeShipping2}
  announceTier3={t.announce.freeShipping3}
  announceCoratina={t.announce.coratinaRestock}
>
  <ShippingPage locale={locale} client:load />
</BaseLayout>
