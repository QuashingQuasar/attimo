---
// Localized (dk/se/fr/de/nl) PDP for the trio bundle ("The Full Collection").
// Same page as /product/trio but per-locale price/currency/language, so the
// shop menu's localized bundle link resolves instead of 404ing. Mirrors
// [locale]/product/coratina-3l.astro and the single-variety [locale] PDPs:
// canonical -> self, hreflang cluster via /product/trio.
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import BundleTrioPageWrapper from "@astro/react-pages/BundleTrioPageWrapper";
import { aggregateRating, reviews } from "@/lib/reviewSchema";
import { LOCALES, formatPrice, type Locale } from "@/lib/i18n/config";
import { trioSinglesTotal, TRIO_CONFIG } from "@/lib/trioBundle";
import { getDict } from "@/lib/i18n/dictionaries";

export function getStaticPaths() {
  return LOCALES.filter((l) => l.slug !== "").map((locale) => ({
    params: { locale: locale.slug },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const price = locale.prices.trio ?? 60;
const singlesTotal = trioSinglesTotal(locale);
const priceLabel = formatPrice(price, locale);

const framing = TRIO_CONFIG.framing[locale.lang] ?? TRIO_CONFIG.framing.en;
const title = `${framing.title} | ${dict.product.titleSuffix}`;
const description = `${framing.description} ${priceLabel}.`;
const canonicalUrl = `https://attimo-oil.com/${locale.slug}/product/trio`;
const ogImage = "https://attimo-oil.com/trio-collection.png";

const productJsonLd = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: `ATTIMO ${framing.title}`,
  description,
  sku: "ATTIMO-TRIO-3x500",
  brand: { "@type": "Brand", name: "Attimo" },
  image: ogImage,
  offers: {
    "@type": "Offer",
    url: canonicalUrl,
    price: price.toFixed(locale.currency.decimals),
    priceCurrency: locale.currency.code,
    availability: TRIO_CONFIG.soldOut
      ? "https://schema.org/OutOfStock"
      : "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating,
  review: reviews,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="product"
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={productJsonLd}
  noIndex={false}
  htmlLang={locale.lang}
  hreflangPath="/product/trio"
  announceTier2={dict.announce.freeShipping2}
  announceTier3={dict.announce.freeShipping3}
>
  <BundleTrioPageWrapper locale={locale} client:load />
</BaseLayout>
