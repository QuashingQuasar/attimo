---
// Localized (dk/se/fr/de/nl) PDP for the duo bundle (Coratina + Nocellara).
// Same page as /product/duo but per-locale price/currency/language, so the
// shop menu's localized bundle link resolves instead of 404ing. Mirrors
// [locale]/product/coratina-3l.astro and the single-variety [locale] PDPs:
// canonical -> self, hreflang cluster via /product/duo.
import BaseLayout from "@astro/layouts/BaseLayout.astro";
import BundleDuoPageWrapper from "@astro/react-pages/BundleDuoPageWrapper";
import { aggregateRating, reviews } from "@/lib/reviewSchema";
import { LOCALES, formatPrice, type Locale } from "@/lib/i18n/config";
import { DUO_CONFIG } from "@/lib/duoBundle";
import { getDict } from "@/lib/i18n/dictionaries";

export function getStaticPaths() {
  return LOCALES.filter((l) => l.slug !== "").map((locale) => ({
    params: { locale: locale.slug },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const price = locale.prices.duo ?? 42;
const priceLabel = formatPrice(price, locale);

const framing = DUO_CONFIG.framing[locale.lang] ?? DUO_CONFIG.framing.en;
const title = `${framing.title} | ${dict.product.titleSuffix}`;
const description = `${framing.description} ${priceLabel}.`;
const canonicalUrl = `https://attimo-oil.com/${locale.slug}/product/duo`;
const ogImage = "https://attimo-oil.com/duo-collection.png";

const productJsonLd = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: "ATTIMO Coratina + Nocellara Duo",
  description,
  sku: "ATTIMO-DUO-2x500",
  brand: { "@type": "Brand", name: "Attimo" },
  image: ogImage,
  offers: {
    "@type": "Offer",
    url: canonicalUrl,
    price: price.toFixed(locale.currency.decimals),
    priceCurrency: locale.currency.code,
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating,
  review: reviews,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="product"
  bodyStyle="background-color: #FFFAEA;"
  jsonLd={productJsonLd}
  noIndex={false}
  htmlLang={locale.lang}
  hreflangPath="/product/duo"
  announceTier2={dict.announce.freeShipping2}
  announceTier3={dict.announce.freeShipping3}
>
  <BundleDuoPageWrapper locale={locale} client:load />
</BaseLayout>
